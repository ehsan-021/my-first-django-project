/* Mars 1.1.0 — compatibility layer for third-party widgets and translation plugins. */
:root{color-scheme:light}html[data-theme="dark"],html.dark{color-scheme:dark}

/* SnappPay WooCommerce gateway/widget: preserve plugin branding while adapting its surface and text. */
.snapppay-widget{box-sizing:border-box;max-width:100%;color:var(--mars-text,var(--color-text,#17211b));border-color:var(--mars-line,var(--color-line,#e3e9e5))}
.snapppay-widget *{box-sizing:border-box}.snapppay-widget-image{flex:0 0 auto;max-width:96px;height:auto;object-fit:contain}
.snapppay-widget-content{min-width:0}.snapppay-widget-title,.snapppay-widget-description{color:inherit}.snapppay-widget .woocommerce-Price-amount{color:inherit}
html[data-theme="dark"] .snapppay-widget,html.dark .snapppay-widget{background:#171a18!important;border-color:#2b332f!important;color:#f7fbf9!important;box-shadow:none!important}
html[data-theme="dark"] .snapppay-widget-description,html.dark .snapppay-widget-description{color:#aab5b0!important}
html[data-theme="dark"] .snapppay-widget-image,html.dark .snapppay-widget-image{filter:none!important}

/* Safe defaults for plugin-generated controls that otherwise become unreadable after a theme switch. */
html[data-theme="dark"] .mars-content-card :where(input:not([type="checkbox"]):not([type="radio"]),select,textarea),html.dark .mars-content-card :where(input:not([type="checkbox"]):not([type="radio"]),select,textarea){color:#f7fbf9;background-color:#171a18;border-color:#2b332f}
html[data-theme="dark"] .woocommerce :where(.select2-container--default .select2-selection--single,.select2-dropdown),html.dark .woocommerce :where(.select2-container--default .select2-selection--single,.select2-dropdown){color:#f7fbf9;background:#171a18;border-color:#2b332f}
html[data-theme="dark"] .woocommerce .select2-container--default .select2-selection--single .select2-selection__rendered,html.dark .woocommerce .select2-container--default .select2-selection--single .select2-selection__rendered{color:#f7fbf9}

/* Prevent translator overlays/badges from being clipped by full-width Mars sections. */
.gtranslate_wrapper,.weglot-container,.wpml-ls,.pll-parent-menu-item{isolation:isolate}
