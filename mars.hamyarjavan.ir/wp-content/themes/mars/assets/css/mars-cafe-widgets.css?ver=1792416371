/* Mars calculator, popular services and crypto-rate widgets. */

/* Currency calculator – compact CafeArz-inspired structure from the supplied reference. */
.mars-currency-calculator{
  --mcc-bg:#f5f8fd;--mcc-card:#fff;--mcc-text:#3f4d7d;--mcc-muted:#7a86a4;--mcc-line:#eef2f8;--mcc-input:#eef5ff;
  --mcc-accent:#18e1b5;--mcc-button-bg:#18e1b5;--mcc-button-text:#063d32;--mcc-button-hover:#14cda5;
  width:100%;margin:0;color:var(--mcc-text);font-family:inherit;background:var(--mcc-bg);padding:16px;border-radius:22px;overflow:hidden
}
.mars-currency-calculator *{box-sizing:border-box}
.mars-currency-calculator__inner{width:100%;max-width:1200px;margin-inline:auto}
.mars-currency-calculator__category{position:absolute!important;width:1px!important;height:1px!important;opacity:0!important;pointer-events:none!important}
.mars-currency-calculator__tabs-shell{overflow:hidden;background:var(--mcc-card);border-radius:18px;margin:0 0 16px;padding:0 22px;box-shadow:0 1px 0 rgba(20,35,70,.02)}
.mars-currency-calculator__tabs{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));align-items:stretch;gap:0;min-height:70px}
.mars-currency-calculator__tab{position:relative;appearance:none;border:0!important;border-radius:0!important;background:transparent!important;color:var(--mcc-text)!important;padding:0 12px!important;margin:0!important;min-height:70px;font:inherit!important;font-size:15px!important;font-weight:750!important;cursor:pointer;box-shadow:none!important;transition:color .18s ease}
.mars-currency-calculator__tab::after{content:"";position:absolute;inset-inline:24%;bottom:0;height:4px;border-radius:8px 8px 0 0;background:transparent;transform:scaleX(.45);transition:transform .18s ease,background .18s ease}
.mars-currency-calculator__tab:hover,.mars-currency-calculator__tab.is-active{background:transparent!important;color:var(--mcc-text)!important}
.mars-currency-calculator__tab.is-active{font-weight:900!important}
.mars-currency-calculator__tab.is-active::after{background:var(--mcc-accent);transform:scaleX(1)}
.mars-currency-calculator__panel{position:relative;display:grid;grid-template-columns:1.15fr 1fr .8fr .78fr;align-items:end;gap:26px;background:var(--mcc-card);border-radius:18px;padding:34px 40px;min-height:188px;box-shadow:0 1px 0 rgba(20,35,70,.02)}
.mars-currency-calculator__block{display:flex;flex-direction:column;justify-content:flex-end;gap:16px;min-width:0;margin:0!important}
.mars-currency-calculator__label{display:block;color:var(--mcc-text);font-size:16px;line-height:1.5;font-weight:800;white-space:nowrap}
.mars-currency-calculator__control,.mars-currency-calculator__amount-control{position:relative;display:flex;align-items:center;width:100%;height:52px;border-radius:10px;background:var(--mcc-input);overflow:hidden}
.mars-currency-calculator__control--select::after,.mars-currency-calculator__amount-control::after{content:"";position:absolute;left:16px;width:8px;height:8px;border-left:2px solid var(--mcc-text);border-bottom:2px solid var(--mcc-text);transform:rotate(-45deg) translateY(-2px);opacity:.8;pointer-events:none}
.mars-currency-calculator__service,.mars-currency-calculator__currency,.mars-currency-calculator__amount{appearance:none!important;-webkit-appearance:none!important;margin:0!important;border:0!important;outline:0!important;box-shadow:none!important;background:transparent!important;color:var(--mcc-text)!important;font:inherit!important;font-size:15px!important;font-weight:800!important;height:52px!important;min-height:52px!important}
.mars-currency-calculator__service{width:100%!important;padding:0 18px 0 44px!important}
.mars-currency-calculator__amount-control{padding:0 0 0 38px}
.mars-currency-calculator__amount{flex:1 1 auto;min-width:50px;width:100%!important;padding:0 18px!important;text-align:right}
.mars-currency-calculator__currency{flex:0 0 155px;width:155px!important;padding:0 16px 0 34px!important;border-right:1px solid color-mix(in srgb,var(--mcc-text) 7%,transparent)!important;border-radius:10px!important;background:color-mix(in srgb,var(--mcc-input) 87%,var(--mcc-card))!important;text-align:center!important}
.mars-currency-calculator__amount-control::after{left:14px}
.mars-currency-calculator__amount::-webkit-outer-spin-button,.mars-currency-calculator__amount::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}.mars-currency-calculator__amount[type=number]{-moz-appearance:textfield}
.mars-currency-calculator__block--total{align-self:end;padding-bottom:0}
.mars-currency-calculator__total{display:flex;align-items:center;width:100%;height:52px;min-height:52px;color:var(--mcc-text);font-size:18px;line-height:1.4;font-weight:950;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mars-currency-calculator__submit{display:flex!important;align-items:center!important;justify-content:center!important;width:100%!important;min-height:52px!important;height:52px!important;margin:0!important;padding:0 18px!important;border:0!important;border-radius:10px!important;background:var(--mcc-button-bg)!important;color:var(--mcc-button-text)!important;text-decoration:none!important;font:inherit!important;font-size:17px!important;font-weight:950!important;box-shadow:0 12px 26px color-mix(in srgb,var(--mcc-button-bg) 20%,transparent)!important;transition:transform .15s ease,background .15s ease,box-shadow .15s ease}
.mars-currency-calculator__submit:hover{background:var(--mcc-button-hover)!important;color:var(--mcc-button-text)!important;transform:translateY(-1px);box-shadow:0 14px 30px color-mix(in srgb,var(--mcc-button-bg) 25%,transparent)!important}
.mars-currency-calculator__status{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important}

/* Popular services */
.mars-popular-services{--mps-bg:#fff;--mps-text:#171b1f;--mps-muted:#737b84;--mps-card:#f7f8fa;--mps-line:#e5e8ec;--mps-accent:#18e1b5;--mps-chip:#fff;width:min(95%,1200px);margin:70px auto;color:var(--mps-text);font-family:inherit}
.mars-popular-services *{box-sizing:border-box}.mars-popular-services__head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:34px}.mars-popular-services__head h2{margin:0;color:var(--mps-text);font-size:clamp(25px,2.2vw,38px);font-weight:950}.mars-popular-services__head p{margin:8px 0 0;color:var(--mps-muted);font-size:14px;font-weight:650}.mars-popular-services__grid{display:grid;grid-template-columns:repeat(var(--mps-cols,3),minmax(0,1fr));gap:var(--mps-gap,16px)}.mars-popular-services__card{position:relative;overflow:hidden;min-width:0;padding:22px;border:1px solid var(--mps-line);border-radius:24px;background:var(--mps-card);box-shadow:0 12px 34px rgba(15,23,42,.04)}.mars-popular-services__card-head{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:18px}.mars-popular-services__card-head h3{margin:0;color:var(--mps-text);font-size:19px;font-weight:900}.mars-popular-services__card-head span{display:block;margin-top:5px;color:var(--mps-muted);font-size:12px;font-weight:700}.mars-popular-services__card-head>a{display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;min-height:36px;padding:0 13px;border:1px solid color-mix(in srgb,var(--mps-accent) 34%,var(--mps-line));border-radius:10px;color:#075c4a!important;background:transparent!important;text-decoration:none!important;font-size:12px;font-weight:850}.mars-popular-services__image{height:150px;margin-bottom:15px;border-radius:17px;overflow:hidden;background:color-mix(in srgb,var(--mps-accent) 8%,var(--mps-chip))}.mars-popular-services__image img{width:100%;height:100%;object-fit:cover;display:block}.mars-popular-services__products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.mars-popular-services__products a{display:flex;align-items:center;min-width:0;min-height:42px;padding:0 12px;border:1px solid var(--mps-line);border-radius:11px;background:var(--mps-chip)!important;color:var(--mps-text)!important;text-decoration:none!important;font-size:12.5px;font-weight:750;transition:border-color .16s,color .16s}.mars-popular-services__products a:hover{border-color:var(--mps-accent);color:#075c4a!important;background:var(--mps-chip)!important}.mars-popular-services__products a span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;width:100%}

/* Crypto rates – compact responsive grid matching the supplied card reference. */
.mars-crypto-rates{--mcr-bg:transparent;--mcr-text:#4e5b8c;--mcr-muted:#59658e;--mcr-card:#f4f6fd;--mcr-accent:#18e1b5;--mcr-positive:#159a68;--mcr-positive-bg:#bdf8d7;--mcr-negative:#df5262;--mcr-negative-bg:#ffe0e4;--mcr-neutral:#777b88;--mcr-neutral-bg:#e8eaf1;width:100%;margin:28px auto;color:var(--mcr-text);font-family:inherit;background:var(--mcr-bg)}
.mars-crypto-rates *{box-sizing:border-box}
.mars-crypto-rates__head{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:18px}.mars-crypto-rates__head h2{margin:0;color:var(--mcr-text);font-size:clamp(21px,1.8vw,30px);font-weight:950}.mars-crypto-rates__head p{margin:6px 0 0;color:var(--mcr-muted);font-size:12.5px;font-weight:650}
.mars-crypto-rates__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.mars-crypto-rate-card{display:grid;grid-template-columns:46px minmax(0,1fr) auto;align-items:center;gap:11px;min-width:0;min-height:84px;padding:11px 13px;border:0;border-radius:16px;background:var(--mcr-card);overflow:hidden}
.mars-crypto-rate-card__icon{display:flex;align-items:center;justify-content:center;width:46px;height:46px;overflow:hidden;border-radius:11px;flex:0 0 auto;background:color-mix(in srgb,var(--mcr-card) 78%,#fff)}
.mars-crypto-rate-card__icon img{display:block;width:46px;height:46px;object-fit:contain;padding:2px}
.mars-crypto-rate-card__info{display:grid;gap:5px;min-width:0;text-align:right}
.mars-crypto-rate-card__name{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--mcr-text);font-size:15px;line-height:1.45;font-weight:900}
.mars-crypto-rate-card__price{display:flex;align-items:center;justify-content:flex-end;gap:4px;min-width:0;color:var(--mcr-muted);font-size:14px;line-height:1.2;font-weight:800;direction:ltr}
.mars-crypto-rate-card__price strong{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--mcr-muted);font:inherit}.mars-crypto-rate-card__price b{font:inherit}
.mars-crypto-rate-card__change{display:inline-flex;align-items:center;justify-content:center;justify-self:start;min-width:72px;min-height:34px;padding:6px 9px;border-radius:8px;font-size:12.5px;font-weight:900;white-space:nowrap;direction:ltr}
.mars-crypto-rate-card__change.is-positive{color:var(--mcr-positive);background:var(--mcr-positive-bg)}.mars-crypto-rate-card__change.is-negative{color:var(--mcr-negative);background:var(--mcr-negative-bg)}.mars-crypto-rate-card__change.is-neutral{color:var(--mcr-neutral);background:var(--mcr-neutral-bg)}

/* Dark mode */
