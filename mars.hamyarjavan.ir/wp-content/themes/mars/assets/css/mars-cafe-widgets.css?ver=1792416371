/* Mars — crypto cards: compact, reference-aligned and resilient. */
.mars-crypto-rates{margin:0 auto!important;max-width:100%;overflow:visible}
.mars-crypto-rates__grid{width:100%;align-items:stretch}
.mars-crypto-rate-card{direction:rtl;width:100%;min-height:92px;padding:12px 14px;border-radius:16px;grid-template-columns:50px minmax(0,1fr) auto;gap:12px;box-shadow:none}
.mars-crypto-rate-card__icon{grid-column:1;justify-self:start;width:50px;height:50px;border-radius:12px;background:color-mix(in srgb,var(--mcr-card) 76%,#fff)}
