  .mars-crypto-rate-card{grid-template-columns:42px minmax(0,1fr) auto;padding:11px!important}.mars-crypto-rate-card__icon,.mars-crypto-rate-card__icon img{width:42px;height:42px}.mars-crypto-rate-card__change{min-width:58px;padding-inline:6px}
