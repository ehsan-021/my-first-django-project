/* Mars — redesigned Popular Services; category images and numbering removed. */
.mars-popular-services{--mps-cols:3;--mps-gap:16px;--mps-product-align:right;--mps-radius:22px;width:100%;max-width:100%;margin:0;background:var(--mps-bg,transparent)}
.mars-popular-services__head{margin-bottom:22px;align-items:flex-start}.mars-popular-services__eyebrow{display:inline-flex;margin-bottom:8px;padding:5px 9px;border-radius:999px;background:color-mix(in srgb,var(--mps-accent) 13%,transparent);color:color-mix(in srgb,var(--mps-accent) 66%,#073b31);font-size:10px;font-weight:900}.mars-popular-services__head h2{font-size:clamp(22px,2vw,31px);line-height:1.5}.mars-popular-services__head p{margin-top:5px;font-size:12px;line-height:1.9}
.mars-popular-services__grid{grid-template-columns:repeat(var(--mps-cols),minmax(0,1fr));gap:var(--mps-gap)}
