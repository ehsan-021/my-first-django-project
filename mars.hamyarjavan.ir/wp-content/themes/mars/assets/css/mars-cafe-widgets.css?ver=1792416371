html[data-theme="dark"] .mars-crypto-rates,body[data-theme="dark"] .mars-crypto-rates,html.dark .mars-crypto-rates,body.dark .mars-crypto-rates{--mcr-bg:transparent;--mcr-text:#f3f6ff;--mcr-muted:#aeb8d2;--mcr-card:#151d2a;--mcr-accent:#18e1b5;--mcr-positive:#39e3ad;--mcr-positive-bg:#173e32;--mcr-negative:#ff8793;--mcr-negative-bg:#472029;--mcr-neutral:#aeb3c0;--mcr-neutral-bg:#2b3340}
html[data-theme="dark"] .mars-popular-services__card-head>a,body[data-theme="dark"] .mars-popular-services__card-head>a,html.dark .mars-popular-services__card-head>a,body.dark .mars-popular-services__card-head>a,html[data-theme="dark"] .mars-popular-services__products a:hover,body[data-theme="dark"] .mars-popular-services__products a:hover,html.dark .mars-popular-services__products a:hover,body.dark .mars-popular-services__products a:hover{color:#18e1b5!important}

