.mars-popular-services__heading{min-width:0}.mars-popular-services__heading h3{margin:0;color:var(--mps-text);font-size:15px;font-weight:900;line-height:1.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mars-popular-services__heading span{display:block;margin-top:3px;color:var(--mps-muted);font-size:10px;font-weight:750}
.mars-popular-services__all{display:inline-flex!important;align-items:center!important;gap:5px!important;min-height:31px!important;padding:0 9px!important;border:0!important;border-radius:9px!important;background:color-mix(in srgb,var(--mps-accent) 10%,transparent)!important;color:var(--mps-accent)!important;font-size:10px!important;font-weight:900!important}.mars-popular-services__all i{font:inherit;font-size:13px}
.mars-popular-services__products{display:grid;grid-template-columns:1fr;gap:7px}.mars-popular-services__products a{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:39px;padding:0 11px;border:1px solid var(--mps-line);border-radius:10px;background:var(--mps-chip)!important;color:var(--mps-text)!important;font-size:11.5px;font-weight:750;transition:transform .15s ease,border-color .15s ease}.mars-popular-services__products a:hover{transform:translateX(-2px);border-color:color-mix(in srgb,var(--mps-accent) 65%,var(--mps-line));color:var(--mps-text)!important}.mars-popular-services__products a span{text-align:var(--mps-product-align);direction:rtl}.mars-popular-services__products a i{flex:0 0 auto;color:var(--mps-muted);font:inherit;font-size:15px}
@media(max-width:900px){.mars-popular-services__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:767px){.mars-popular-services{width:100%;margin:0}.mars-popular-services__grid{grid-template-columns:1fr!important}.mars-popular-services__card{padding:15px}.mars-popular-services__card-head{grid-template-columns:34px minmax(0,1fr) auto}.mars-popular-services__number{width:34px;height:34px}.mars-popular-services__heading h3{font-size:14px}}

/* Mars — Popular Services without decorative numbering. */
.mars-popular-services__card-head{grid-template-columns:minmax(0,1fr) auto!important;gap:12px!important}
.mars-popular-services__number{display:none!important}
@media(max-width:767px){.mars-popular-services__card-head{grid-template-columns:minmax(0,1fr) auto!important}}
