/* Mars — linked buttons */
.mars-linked-buttons{--mlb-bg:#18e1b5;--mlb-text:#fff;--mlb-hover:#12c8a1;display:flex;align-items:center;justify-content:flex-start;flex-wrap:wrap;gap:10px;width:100%;box-sizing:border-box}
.mars-linked-button{display:inline-flex;align-items:center;justify-content:center;width:var(--mlb-item-width,auto);max-width:100%;min-height:var(--mlb-item-height,48px);padding:8px 22px;border:0;border-radius:10px;background:var(--mlb-bg);color:var(--mlb-text)!important;text-decoration:none!important;font-size:var(--mlb-item-font-size,14px);font-weight:850;line-height:1.3;white-space:nowrap;box-sizing:border-box;transition:transform .18s ease,background-color .18s ease,box-shadow .18s ease}
.mars-linked-button:hover{background:var(--mlb-hover);color:var(--mlb-text)!important;transform:translateY(-1px);box-shadow:0 8px 22px rgba(15,23,42,.1)}
.elementor-widget-mars_linked_buttons .mars-linked-button.is-individual{background-color:var(--mlb-item-bg)!important;color:var(--mlb-item-text)!important}
.elementor-widget-mars_linked_buttons .mars-linked-button.is-individual:hover,.elementor-widget-mars_linked_buttons .mars-linked-button.is-individual:focus{background-color:var(--mlb-item-hover)!important;color:var(--mlb-item-text)!important}
@media(max-width:520px){.mars-linked-button{min-width:0;max-width:100%}}
