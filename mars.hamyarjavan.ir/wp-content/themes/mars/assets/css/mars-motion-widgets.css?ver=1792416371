/* Mars — loop-video and animated statistics. */
.mars-loop-video-wrap{display:flex;width:100%}.mars-loop-video{width:100%;max-width:100%}.mars-loop-video__frame{position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;border-radius:20px;background:transparent}.mars-loop-video__frame video{display:block;width:100%;height:100%;max-width:none;margin:0;object-fit:cover;background:transparent}
.mars-animated-stats{--mas-cols:5;--mas-text:#101b35;--mas-muted:#71809b;--mas-number:#1859d8;--mas-line:#dce3ef;width:100%;box-sizing:border-box;background:transparent;color:var(--mas-text);padding-top:20px}.mars-animated-stats *{box-sizing:border-box}.mars-animated-stats__head{max-width:780px;margin:0 auto 56px;text-align:center}.mars-animated-stats__head h2{margin:0 0 15px;color:var(--mas-text)!important;font-size:clamp(28px,3.4vw,44px)!important;font-weight:950!important;line-height:1.5!important}.mars-animated-stats__head p{margin:0;color:var(--mas-muted);font-size:clamp(13px,1.3vw,18px);line-height:2}.mars-animated-stats__grid{display:grid;grid-template-columns:repeat(var(--mas-cols),minmax(0,1fr));direction:rtl}.mars-animated-stat{display:flex;min-width:0;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:18px 20px;text-align:center;border-inline-start:1px solid var(--mas-line)}.mars-animated-stat:first-child{border-inline-start:0}.mars-animated-stat strong{display:flex;align-items:baseline;justify-content:center;gap:5px;direction:rtl;color:var(--mas-number);font-size:clamp(34px,4vw,58px);font-weight:950;line-height:1.25;white-space:nowrap}.mars-animated-stat__after,.mars-animated-stat__before{font-size:.78em}.mars-animated-stat>span{color:var(--mas-muted);font-size:clamp(12px,1.25vw,17px);font-weight:650;line-height:1.8}
html[data-theme="dark"] .mars-animated-stats,html.dark .mars-animated-stats{background:transparent}
@media(max-width:900px){.mars-animated-stats__head{margin-bottom:34px}.mars-animated-stats__grid{row-gap:22px}.mars-animated-stat{border:0;border-inline-start:1px solid var(--mas-line)}.mars-animated-stat:nth-child(3n+1){border-inline-start:0}}
@media(max-width:620px){.mars-animated-stats__head{margin-bottom:24px}.mars-animated-stats__grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:20px 0}.mars-animated-stat{padding:10px 8px}.mars-animated-stat:nth-child(odd){border-inline-start:0}.mars-animated-stat:nth-child(even){border-inline-start:1px solid var(--mas-line)}.mars-animated-stat strong{font-size:32px}.mars-animated-stat>span{font-size:11px}}
@media(prefers-reduced-motion:reduce){.mars-animated-stat__number{transition:none!important}}

/* Mars — counters stay inside their cards while animating. */
.mars-animated-stat{overflow:hidden;container-type:inline-size}
.mars-animated-stat strong{max-width:100%;min-width:0;overflow:hidden;text-overflow:clip}
.mars-animated-stat__number{display:inline-block;min-width:0;max-width:100%}
@supports (font-size: 1cqw){.mars-animated-stat strong{font-size:clamp(24px,15cqw,58px)}}
