@media(max-width:620px){
  .mars-team-card{
    flex-basis:min(var(--mtm-mobile-card,220px),calc(100vw - 42px))!important;
    width:min(var(--mtm-mobile-card,220px),calc(100vw - 42px))!important;
    max-width:min(var(--mtm-mobile-card,220px),calc(100vw - 42px))!important;
  }
}

/* Mars — preserve semantic heading hierarchy inside Elementor Text Editor. */
.elementor-widget-text-editor .elementor-widget-container h1{
  display:block;
  margin:.35em 0 .55em;
  font-size:clamp(30px,4vw,48px)!important;
  line-height:1.35!important;
  font-weight:900!important;
  letter-spacing:-.02em;
}
@media(max-width:767px){.elementor-widget-text-editor .elementor-widget-container h1{font-size:clamp(26px,8vw,36px)!important}}
