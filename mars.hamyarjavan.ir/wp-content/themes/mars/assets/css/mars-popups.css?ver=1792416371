/* Mars — lightweight Global Popup rendering */
.mars-popup-overlay{
	opacity:0;
	transition:opacity .18s ease;
	contain:layout paint style;
	isolation:isolate;
}
.mars-popup-overlay.is-visible{
	opacity:1;
}
.mars-popup-overlay::before{
	backdrop-filter:none!important;
	-webkit-backdrop-filter:none!important;
	will-change:opacity;
}
.mars-popup-box{
	contain:layout paint style;
	transform:translateZ(0);
	will-change:transform,opacity;
}
.mars-popup-media,
.mars-popup-image{
	contain:paint;
}

/* Mars - responsive popup media without mobile cropping */
.mars-popup-media>a{display:block;width:100%;height:100%;color:inherit;text-decoration:none}
.mars-popup-box--image .mars-popup-media{background:var(--mars-popup-bg,#fff)}
@media(max-width:600px){
  .mars-popup-overlay{align-items:center!important;padding:10px!important}
  .mars-popup-box{
    width:min(var(--mars-popup-width,540px),calc(100vw - 20px))!important;
    max-height:calc(100dvh - 20px)!important;
    overflow:auto!important;
    border-radius:min(var(--mars-popup-radius,20px),18px)!important;
    overscroll-behavior:contain!important;
  }
  .mars-popup-media{
    width:100%!important;
    height:auto!important;
    min-height:0!important;
    max-height:56dvh!important;
    display:grid!important;
    place-items:center!important;
    overflow:hidden!important;
    background:color-mix(in srgb,var(--mars-popup-border,#e2e8f0) 22%,var(--mars-popup-bg,#fff))!important;
  }
  .mars-popup-media>a{height:auto!important;max-height:56dvh!important;display:grid!important;place-items:center!important}
  .mars-popup-image{
    width:100%!important;
    height:auto!important;
    max-width:100%!important;
    max-height:56dvh!important;
    object-fit:contain!important;
    object-position:center!important;
  }
  .mars-popup-box--image .mars-popup-media,
  .mars-popup-box--image .mars-popup-media>a{max-height:calc(100dvh - 20px)!important}
  .mars-popup-box--image .mars-popup-image{max-height:calc(100dvh - 20px)!important}
  .mars-popup-box--image .mars-popup-close{background:color-mix(in srgb,var(--mars-popup-bg,#fff) 88%,transparent)!important;backdrop-filter:blur(8px)!important;-webkit-backdrop-filter:blur(8px)!important}
  .mars-popup-body{padding:18px 15px calc(18px + env(safe-area-inset-bottom,0px))!important}
  .mars-popup-title{font-size:18px!important;line-height:1.65!important}
  .mars-popup-text{font-size:13px!important;line-height:1.9!important}
  .mars-popup-actions{margin-top:14px!important}
  .mars-popup-button{min-height:45px!important;border-radius:12px!important}
}
@media(max-width:380px){
  .mars-popup-overlay{padding:6px!important}
  .mars-popup-box{width:calc(100vw - 12px)!important;max-height:calc(100dvh - 12px)!important}
  .mars-popup-close{top:8px!important;left:8px!important;width:36px!important;height:36px!important}
  .mars-popup-body{padding-inline:12px!important}
}


/* Mars — global popup media is never cropped on desktop. */
@media(min-width:601px){
  .mars-popup-media{
    height:var(--mars-popup-image-height,300px)!important;
    min-height:0!important;
    display:grid!important;
    place-items:center!important;
    overflow:hidden!important;
    background:color-mix(in srgb,var(--mars-popup-border,#e2e8f0) 22%,var(--mars-popup-bg,#fff))!important;
