/* Mars product widgets, AJAX search and Contact Us form. */
.mars-elementor-products,
.mars-ajax-search{box-sizing:border-box;font-family:inherit}
.mars-elementor-products *,
.mars-ajax-search *{box-sizing:border-box}

/* Shop-style product grid */
.mars-elementor-products{--mep-cols:4;--mep-gap:16px;--mep-card:#f3f6fa;--mep-title:#182230;--mep-muted:#687385;--mep-category:#64748b;--mep-discount:#ef4444;--mep-radius:20px;--mep-ratio:16 / 9;--mep-fit:contain;--mep-title-align:center;display:grid;grid-template-columns:repeat(var(--mep-cols),minmax(0,1fr));gap:var(--mep-gap);width:100%}
.mars-elementor-product-card{position:relative;min-width:0;margin:0;background:var(--mep-card);border:0;border-radius:var(--mep-radius);overflow:hidden;transition:transform .18s ease}
.mars-elementor-product-card:hover{transform:translateY(-2px)}
.mars-elementor-product-card__link{display:flex;flex-direction:column;height:100%;color:inherit!important;text-decoration:none!important;background:transparent!important}
.mars-elementor-product-card__media{position:relative;display:block;width:100%;aspect-ratio:var(--mep-ratio);overflow:hidden;background:color-mix(in srgb,var(--mep-card) 80%,#fff)}
.mars-elementor-product-card__media img{display:block!important;width:100%!important;height:100%!important;margin:0!important;border:0!important;border-radius:0!important;object-fit:var(--mep-fit)!important;object-position:center!important;box-shadow:none!important}
.mars-elementor-product-card.is-out-of-stock .mars-elementor-product-card__media img{filter:grayscale(1);opacity:.68}
.mars-elementor-product-card__discount{position:absolute;z-index:2;top:9px;right:9px;display:inline-flex;align-items:center;justify-content:center;min-width:39px;height:26px;padding:0 8px;border-radius:8px;background:var(--mep-discount);color:#fff;font-size:11px;font-weight:900}
.mars-elementor-product-card__body{display:flex;flex:1;flex-direction:column;min-width:0;padding:13px 12px 14px}
.mars-elementor-product-card__category{display:block;margin-bottom:5px;color:var(--mep-category);font-size:10.5px;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:var(--mep-title-align)}
.mars-elementor-product-card__title{display:block;color:var(--mep-title);font-size:14px;font-weight:850;line-height:1.55;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:var(--mep-title-align)}
.mars-elementor-product-card__price{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:11px;color:var(--mep-muted);font-size:10.5px;line-height:1.4}
.mars-elementor-product-card__price small{font:inherit;font-weight:750;white-space:nowrap}
.mars-elementor-product-card__price strong{display:flex;align-items:center;gap:4px;color:inherit;font-size:11px;font-weight:850;white-space:nowrap;direction:rtl}
.mars-elementor-product-card__price b,.mars-elementor-product-card__price i{font:inherit;font-style:normal}
html[data-theme="dark"] .mars-elementor-products,html.dark .mars-elementor-products{--mep-card:#151d2a;--mep-title:#f8fafc;--mep-muted:#9aa6b2;--mep-category:#a5b4c7}

/* AJAX search */
.mars-ajax-search{--mas-box:#fff;--mas-input:#f5f7fb;--mas-text:#182230;--mas-muted:#7b8794;--mas-line:#e4e9f0;--mas-accent:#18e1b5;position:relative;width:100%;color:var(--mas-text)}
.mars-ajax-search__field{position:relative;display:flex;align-items:center;width:100%;height:54px;margin:0;border:1px solid var(--mas-line);border-radius:15px;background:var(--mas-input);overflow:hidden}
.mars-ajax-search__field input{width:100%!important;height:100%!important;margin:0!important;padding:0 46px 0 48px!important;border:0!important;outline:0!important;background:transparent!important;color:var(--mas-text)!important;font:inherit!important;font-size:14px!important;font-weight:700!important;box-shadow:none!important}
.mars-ajax-search__field input::placeholder{color:var(--mas-muted)}
.mars-ajax-search__icon{position:absolute;right:17px;width:18px;height:18px;border:2px solid var(--mas-muted);border-radius:50%;pointer-events:none}
.mars-ajax-search__icon:after{content:"";position:absolute;width:7px;height:2px;left:-5px;bottom:-3px;border-radius:3px;background:var(--mas-muted);transform:rotate(45deg)}
.mars-ajax-search__loader{position:absolute;left:17px;width:17px;height:17px;border:2px solid color-mix(in srgb,var(--mas-muted) 30%,transparent);border-top-color:var(--mas-accent);border-radius:50%;opacity:0;animation:marsSpin .7s linear infinite}
.mars-ajax-search.is-loading .mars-ajax-search__loader{opacity:1}@keyframes marsSpin{to{transform:rotate(360deg)}}
.mars-ajax-search__results{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:11px}
.mars-ajax-search__results:empty{display:none}
.mars-ajax-search__empty{grid-column:1/-1;padding:16px;border:1px dashed var(--mas-line);border-radius:13px;color:var(--mas-muted);background:var(--mas-box);text-align:center;font-size:12px}
.mars-ajax-search .mars-elementor-product-card{--mep-card:var(--mas-box);--mep-title:var(--mas-text);--mep-muted:var(--mas-muted);--mep-category:var(--mas-muted);--mep-discount:#ef4444;--mep-radius:14px;border:1px solid var(--mas-line)}
.mars-ajax-search .mars-elementor-product-card__body{padding:9px 9px 10px}.mars-ajax-search .mars-elementor-product-card__title{font-size:11.5px}.mars-ajax-search .mars-elementor-product-card__category{font-size:9px}.mars-ajax-search .mars-elementor-product-card__price{font-size:9px;margin-top:7px}.mars-ajax-search .mars-elementor-product-card__price strong{font-size:9.5px}.mars-ajax-search .mars-elementor-product-card__discount{top:6px;right:6px;min-width:31px;height:21px;font-size:8.5px;border-radius:6px}
html[data-theme="dark"] .mars-ajax-search,html.dark .mars-ajax-search{--mas-box:#111827;--mas-input:#0b1220;--mas-text:#f8fafc;--mas-muted:#94a3b8;--mas-line:#283548}


.mars-contact-us{--mcu-card:#fff;--mcu-panel:#f2f7fb;--mcu-text:#172033;--mcu-muted:#718096;--mcu-input:#f8fafc;--mcu-line:#e2e8f0;--mcu-accent:#18e1b5;display:grid;grid-template-columns:minmax(240px,.72fr) minmax(0,1.35fr);width:100%;overflow:hidden;border:1px solid var(--mcu-line);border-radius:24px;background:var(--mcu-card);color:var(--mcu-text)}
.mars-contact-us *{box-sizing:border-box}.mars-contact-us__intro{position:relative;min-height:100%;padding:34px 30px;background:var(--mcu-panel);overflow:hidden}.mars-contact-us__eyebrow{display:inline-flex;margin-bottom:10px;padding:5px 10px;border-radius:999px;background:color-mix(in srgb,var(--mcu-accent) 12%,transparent);color:color-mix(in srgb,var(--mcu-accent) 65%,var(--mcu-text));font-size:10.5px;font-weight:900}.mars-contact-us__intro h2{margin:0 0 10px;color:var(--mcu-text);font-size:clamp(23px,2vw,31px);font-weight:950;line-height:1.55}.mars-contact-us__intro p{margin:0;color:var(--mcu-muted);font-size:12px;line-height:2}.mars-contact-us__visual{position:relative;width:150px;height:120px;margin:34px auto 0}.mars-contact-us__visual:before,.mars-contact-us__visual:after,.mars-contact-us__visual span{content:"";position:absolute;border-radius:24px;border:1px solid color-mix(in srgb,var(--mcu-accent) 25%,var(--mcu-line));background:color-mix(in srgb,var(--mcu-accent) 7%,transparent)}.mars-contact-us__visual:before{inset:20px 15px 0}.mars-contact-us__visual:after{inset:8px 27px 12px}.mars-contact-us__visual span:first-child{width:80px;height:80px;left:35px;top:0;transform:rotate(14deg)}.mars-contact-us__visual i{position:absolute;z-index:2;inset:34px auto auto 50px;display:grid;place-items:center;width:50px;height:50px;border-radius:16px;background:var(--mcu-accent);color:#073b31;font-size:22px;font-style:normal}
.mars-contact-us__form{margin:0;padding:30px}.mars-contact-us__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.mars-contact-us__grid label{display:grid;gap:7px;margin:0;min-width:0}.mars-contact-us__grid label.is-full{grid-column:1/-1}.mars-contact-us__grid label>span{color:var(--mcu-text);font-size:11px;font-weight:850}.mars-contact-us__grid label b{margin-right:3px;color:#ef4444}.mars-contact-us__grid input,.mars-contact-us__grid textarea{width:100%!important;margin:0!important;border:1px solid var(--mcu-line)!important;border-radius:12px!important;outline:0!important;background:var(--mcu-input)!important;color:var(--mcu-text)!important;font:inherit!important;font-size:12.5px!important;box-shadow:none!important;transition:border-color .17s ease,box-shadow .17s ease!important}.mars-contact-us__grid input{height:48px!important;padding:0 13px!important}.mars-contact-us__grid textarea{min-height:140px!important;padding:12px 13px!important;resize:vertical}.mars-contact-us__grid input:focus,.mars-contact-us__grid textarea:focus{border-color:var(--mcu-accent)!important;box-shadow:0 0 0 3px color-mix(in srgb,var(--mcu-accent) 9%,transparent)!important}.mars-contact-us__actions{display:flex;align-items:center;gap:15px;margin-top:15px}.mars-contact-us__actions button{display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:9px!important;min-width:150px!important;height:49px!important;margin:0!important;padding:0 20px!important;border:0!important;border-radius:12px!important;background:var(--mcu-accent)!important;color:#073b31!important;font:inherit!important;font-size:12.5px!important;font-weight:950!important;cursor:pointer!important;box-shadow:none!important}.mars-contact-us__actions button i{font:inherit;font-size:16px}.mars-contact-us__actions small{color:var(--mcu-muted);font-size:9.5px;line-height:1.8}.mars-contact-us__status{min-height:20px;margin-top:9px;color:var(--mcu-muted);font-size:11px;font-weight:750}.mars-contact-us__status.is-success{color:#159a68}.mars-contact-us__status.is-error{color:#d63b4b}.mars-contact-us__hp{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;opacity:0!important}.mars-contact-us.is-sending button{opacity:.6;cursor:wait!important}
html[data-theme="dark"] .mars-contact-us,html.dark .mars-contact-us{--mcu-card:#111827;--mcu-panel:#0b1220;--mcu-text:#f8fafc;--mcu-muted:#94a3b8;--mcu-input:#101827;--mcu-line:#263244}

@media(max-width:900px){.mars-contact-us{grid-template-columns:1fr!important}.mars-contact-us__intro{min-height:auto}.mars-contact-us__visual{display:none}.mars-contact-us__form{padding:24px}}
@media(max-width:767px){.mars-contact-us__grid{grid-template-columns:1fr!important}.mars-contact-us__grid label.is-full{grid-column:auto}.mars-contact-us{border-radius:18px}.mars-contact-us__intro{padding:24px 18px}.mars-contact-us__form{padding:20px 14px}.mars-contact-us__actions{align-items:stretch;flex-direction:column}.mars-contact-us__actions button{width:100%!important}.mars-contact-us__actions small{text-align:center}}


/* Enhanced product search. */
.mars-ajax-search__progress{display:none;align-items:center;gap:8px;min-height:30px;margin-top:7px;color:var(--mas-muted);font-size:10.5px;font-weight:800}.mars-ajax-search__progress span{display:block;width:14px;height:14px;border:2px solid color-mix(in srgb,var(--mas-muted) 28%,transparent);border-top-color:var(--mas-accent);border-radius:50%;animation:marsSpin .65s linear infinite}.mars-ajax-search.is-loading .mars-ajax-search__progress{display:flex}.mars-ajax-search.is-loading .mars-ajax-search__results{opacity:.55;pointer-events:none}
.mars-ajax-search-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(220px,.7fr);gap:28px;align-items:center;padding:28px;border:1px solid var(--mas-line);border-radius:24px;background:var(--mas-box);overflow:hidden}.mars-ajax-search-hero__content{min-width:0}.mars-ajax-search-hero__eyebrow{display:inline-flex;margin-bottom:10px;padding:5px 10px;border-radius:999px;background:color-mix(in srgb,var(--mas-accent) 12%,transparent);color:color-mix(in srgb,var(--mas-accent) 70%,var(--mas-text));font-size:10px;font-weight:900}.mars-ajax-search-hero h2{margin:0 0 8px;color:var(--mas-text);font-size:clamp(24px,3vw,38px);font-weight:950;line-height:1.45}.mars-ajax-search-hero__desc{margin:0 0 18px;color:var(--mas-muted);font-size:13px;line-height:2}.mars-ajax-search-hero__search-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px}.mars-ajax-search-hero .mars-ajax-search__field{height:56px}.mars-ajax-search__submit{display:inline-flex!important;align-items:center!important;justify-content:center!important;min-width:116px!important;height:56px!important;margin:0!important;padding:0 18px!important;border:0!important;border-radius:15px!important;background:var(--mas-accent)!important;color:#073b31!important;font:inherit!important;font-size:12.5px!important;font-weight:950!important;cursor:pointer!important;box-shadow:none!important}.mars-ajax-search-hero__visual{display:flex;align-items:center;justify-content:center;min-height:220px}.mars-ajax-search-hero__visual img{display:block;width:100%;max-width:360px;max-height:260px;object-fit:contain}.mars-ajax-search-hero .mars-ajax-search__results{grid-column:1/-1;margin-top:3px}
@media(max-width:767px){.mars-ajax-search-hero{grid-template-columns:1fr;padding:20px 14px}.mars-ajax-search-hero__visual{order:-1;min-height:140px}.mars-ajax-search-hero__visual img{max-height:160px}.mars-ajax-search-hero__search-row{grid-template-columns:1fr}.mars-ajax-search__submit{width:100%!important}}

/* Mars — tighter title-to-price/card-bottom rhythm in product widgets. */
.mars-elementor-products{align-items:start}.mars-elementor-product-card{align-self:start;height:auto}.mars-elementor-product-card__body{flex:0 0 auto;padding-bottom:11px}.mars-elementor-product-card__price{margin-top:7px}
