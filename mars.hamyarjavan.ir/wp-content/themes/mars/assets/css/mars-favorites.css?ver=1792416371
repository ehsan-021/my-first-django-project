.mars-single-favorite-wrap{margin:0 0 14px}.mars-favorite-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:8px 14px;border:1px solid var(--mars-service-line,#e5e7eb);border-radius:12px;background:var(--mars-product-surface,#fff);color:var(--mars-service-ink,#263238);font:inherit;font-size:13px;font-weight:850;line-height:1.3;cursor:pointer;transition:border-color .18s ease,background .18s ease,color .18s ease,opacity .18s ease}.mars-favorite-button:hover{border-color:#e65b6a;color:#c83f50}.mars-favorite-button__icon{display:grid;place-items:center;width:20px;height:20px;flex:0 0 20px}.mars-favorite-button__icon svg{width:19px;height:19px;display:block}.mars-favorite-button.is-active{border-color:color-mix(in srgb,#e34d5f 42%,transparent);background:color-mix(in srgb,#e34d5f 8%,var(--mars-product-surface,#fff));color:#d33e50}.mars-favorite-button.is-active path{fill:currentColor}.mars-favorite-button.is-loading{opacity:.58;pointer-events:none}.mars-favorite-button--loop{width:calc(100% - 20px);margin:8px 10px 10px;min-height:38px;font-size:12px}.mars-favorite-button--account{min-height:38px;padding:7px 11px;background:transparent}.mars-favorite-toast{position:fixed;left:24px;bottom:24px;z-index:999999;max-width:min(360px,calc(100vw - 32px));padding:12px 16px;border-radius:12px;background:#17211b;color:#fff;font-size:13px;font-weight:800;box-shadow:0 12px 35px rgba(0,0,0,.18);opacity:0;transform:translateY(10px);pointer-events:none;transition:.2s ease}.mars-favorite-toast.is-visible{opacity:1;transform:none}@media(max-width:600px){.mars-favorite-toast{left:16px;right:16px;bottom:84px;max-width:none;text-align:center}.mars-favorite-button--single{width:100%}}

/* Mars — account favorites use the same card language as the Shop page. */
.mars-favorites-page{--mars-shop-card-body:var(--mars-shop-card-bg,var(--mup-soft));--mars-shop-card-title:var(--mup-text);--mars-shop-card-muted:var(--mup-muted);padding:0!important;border:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important}
.mars-favorites-page .mars-pro-page-head{margin-bottom:18px}
.mars-favorites-count{display:inline-flex;align-items:center;min-height:34px;padding:0 11px;border:1px solid var(--mup-border);border-radius:10px;background:var(--mup-soft);color:var(--mup-muted);font-size:12px;font-weight:850}
.mars-favorites-shop-grid,.mars-favorites-shop-grid.columns-4{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:18px!important;width:100%!important;margin:0!important;padding:0!important;list-style:none!important;clear:both}
.mars-favorites-shop-grid:before,.mars-favorites-shop-grid:after{display:none!important;content:none!important}
.mars-favorites-shop-grid li.product,.mars-favorites-shop-grid li.product.first,.mars-favorites-shop-grid li.product.last{position:relative!important;display:block!important;float:none!important;clear:none!important;width:100%!important;max-width:none!important;height:auto!important;margin:0!important;padding:0!important;border:0!important;border-radius:20px!important;background:var(--mars-shop-card-body)!important;box-shadow:none!important;overflow:hidden!important;transition:opacity .2s ease,transform .18s ease}
.mars-favorites-shop-grid li.product:hover{transform:translateY(-2px)!important}
.mars-favorites-shop-grid li.product.is-removing{opacity:0!important;transform:scale(.97)!important;pointer-events:none}
.mars-favorite-shop-card__link{display:flex!important;flex-direction:column!important;height:auto!important;color:inherit!important;text-decoration:none!important;background:transparent!important}
.mars-favorite-shop-card__media{position:relative;overflow:hidden;background:var(--mup-soft)}
.mars-favorite-shop-card__media img{display:block!important;width:100%!important;max-width:none!important;height:auto!important;aspect-ratio:16/9!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;background:var(--mup-surface)!important;object-fit:cover!important;object-position:center!important;box-shadow:none!important}
.mars-favorite-shop-card.outofstock .mars-favorite-shop-card__media img{filter:grayscale(1)!important;opacity:.68!important}
.mars-favorite-remove{position:absolute;z-index:9;top:10px;left:10px;display:inline-flex;align-items:center;justify-content:center;gap:5px;min-height:29px;padding:0 9px;border:0;border-radius:9px;background:rgba(20,24,22,.82);color:#fff;font:inherit;font-size:10px;font-weight:900;line-height:1;cursor:pointer;backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px);transition:background .18s ease,opacity .18s ease,transform .18s ease}
.mars-favorite-remove span{font-size:17px;font-weight:500;line-height:1;transform:translateY(-1px)}
.mars-favorite-remove b{font:inherit;font-weight:900}
.mars-favorite-remove:hover{background:#dc3f4f;color:#fff;transform:translateY(-1px)}
.mars-favorite-remove.is-loading,.mars-favorite-remove:disabled{opacity:.55;cursor:wait;pointer-events:none}
.mars-favorites-shop-grid .woocommerce-loop-product__title{display:block!important;width:100%!important;min-height:0!important;margin:0!important;padding:12px 12px 4px!important;color:var(--mars-shop-card-title)!important;font-size:16px!important;font-weight:650!important;line-height:1.45!important;text-align:center!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
.mars-favorites-shop-grid .mars-shop-card-price{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:8px!important;margin-top:0!important;padding:2px 12px 13px!important;color:var(--mars-shop-card-muted)!important;font-size:12px!important;line-height:1.7!important;direction:rtl}
.mars-favorites-shop-grid .mars-shop-card-price>span{font-weight:700!important;white-space:nowrap!important}
.mars-favorites-shop-grid .mars-shop-card-price>strong{display:flex!important;flex-direction:row!important;align-items:center!important;gap:4px!important;margin:0!important;color:var(--mars-shop-card-muted)!important;font-size:12px!important;font-weight:750!important;white-space:nowrap!important;direction:rtl!important;unicode-bidi:isolate}
.mars-favorites-shop-grid .mars-shop-price-number{order:0}.mars-favorites-shop-grid .mars-shop-price-unit{order:1}
.mars-favorites-shop-grid .mars-shop-discount-badge{position:absolute;z-index:5;top:10px;right:10px;display:inline-flex;align-items:center;justify-content:center;min-width:42px;height:28px;padding:0 9px;border-radius:9px;background:var(--mars-shop-discount-bg,#ef4444);color:#fff;font-size:11px;font-weight:900;line-height:1;direction:rtl}
.mars-favorites-empty{display:grid;place-items:center;text-align:center;gap:9px;padding:50px 18px;border:1px dashed var(--mup-border);border-radius:16px;background:var(--mup-soft)}
.mars-favorites-empty[hidden],.mars-favorites-shop-grid[hidden],.mars-favorites-count[hidden]{display:none!important}
.mars-favorites-empty>span{font-size:42px;color:var(--mup-primary)}.mars-favorites-empty strong{color:var(--mup-text);font-size:16px}.mars-favorites-empty p{max-width:480px;margin:0;color:var(--mup-muted);line-height:1.9}.mars-favorites-empty a{display:inline-flex;align-items:center;justify-content:center;min-height:40px;margin-top:4px;padding:0 14px;border-radius:10px;background:var(--mup-primary);color:#fff!important;text-decoration:none!important;font-weight:900}
@media(max-width:768px){.mars-favorites-shop-grid,.mars-favorites-shop-grid.columns-4{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@media(max-width:600px){.mars-favorites-shop-grid,.mars-favorites-shop-grid.columns-4{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important}.mars-favorites-shop-grid li.product{border-radius:15px!important}.mars-favorites-shop-grid .woocommerce-loop-product__title{padding:8px 8px 3px!important;font-size:13px!important}.mars-favorites-shop-grid .mars-shop-card-price{padding:2px 8px 10px!important;gap:5px!important;font-size:10px!important}.mars-favorites-shop-grid .mars-shop-card-price>strong{gap:2px!important;font-size:10px!important}.mars-favorite-remove{top:7px;left:7px;min-height:25px;padding:0 7px;border-radius:7px;font-size:9px}.mars-favorite-remove span{font-size:15px}.mars-favorites-shop-grid .mars-shop-discount-badge{top:7px;right:7px;min-width:34px;height:23px;padding:0 6px;border-radius:7px;font-size:9px}}

/* Mars — compact natural-height favorite cards. */
.mars-favorites-shop-grid{align-items:start!important}.mars-favorites-shop-grid li.product{align-self:start!important}
