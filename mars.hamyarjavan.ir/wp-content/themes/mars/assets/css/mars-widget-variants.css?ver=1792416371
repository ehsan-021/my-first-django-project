/* Mars-specific visual variations for widgets intentionally not copied 1:1. */

/* Mars Video Introduction: softer split-panel treatment and a rounded media frame. */
.elementor-widget-mars_video_introduction .mars-video-introduction{
  padding:clamp(18px,2.4vw,34px);
  border:1px solid color-mix(in srgb,var(--mvi-frame) 78%,transparent);
  border-radius:32px;
  background:linear-gradient(135deg,color-mix(in srgb,var(--mvi-bar) 96%,transparent),color-mix(in srgb,var(--mvi-accent) 5%,var(--mvi-bar)));
  gap:clamp(32px,5vw,var(--mvi-gap));
}
.elementor-widget-mars_video_introduction .mars-video-introduction__frame{
  padding:10px;
  border-radius:30px 30px 18px 30px;
  box-shadow:0 18px 45px rgba(24,34,54,.08);
}
.elementor-widget-mars_video_introduction .mars-video-introduction__button{
  border-radius:999px;
  box-shadow:0 8px 22px color-mix(in srgb,var(--mvi-accent) 18%,transparent);
}
.elementor-widget-mars_video_introduction .mars-video-introduction__button-icon svg,
.elementor-widget-mars_video_introduction .mars-video-introduction__clock svg{
  width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;
}

/* Mars Display Categories: colored imagery by default, accent rail, lighter hover motion. */
.elementor-widget-mars_category_showcase .mars-category-showcase{
  border:1px solid color-mix(in srgb,var(--mcs-border) 88%,transparent);
  border-radius:28px;
}
.elementor-widget-mars_category_showcase .mars-category-showcase__card::after{
  content:"";position:absolute;inset:0 18% auto 18%;height:3px;border-radius:0 0 999px 999px;background:var(--mcs-accent);opacity:.72;z-index:3;
}
.elementor-widget-mars_category_showcase .mars-category-showcase__media img{
  filter:saturate(.9) contrast(.98);
}
.elementor-widget-mars_category_showcase .mars-category-showcase__card:hover{
  transform:translateY(-3px);
  box-shadow:0 14px 34px rgba(27,35,56,.10);
}
.elementor-widget-mars_category_showcase .mars-category-showcase__card:hover .mars-category-showcase__media img{
  filter:saturate(1.05) contrast(1);
  transform:scale(1.035);
}
.elementor-widget-mars_category_showcase .mars-category-showcase__placeholder-svg svg,
.elementor-widget-mars_category_showcase .mars-category-showcase__arrow-svg svg{
  width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;
}

/* Mars Modern FAQ — clean question cards and borderless animated answers. */
.elementor-widget-mars_modern_faq .mars-modern-faq__list{
  gap:14px;
}
.elementor-widget-mars_modern_faq .mars-modern-faq__item{
  position:relative;
  border:0!important;
  border-radius:var(--mmf-radius);
  overflow:visible;
  background:transparent!important;
}
.elementor-widget-mars_modern_faq .mars-modern-faq__item::before{
  content:none!important;
  display:none!important;
}
.elementor-widget-mars_modern_faq .mars-modern-faq__question{
  border:1px solid color-mix(in srgb,var(--mmf-question) 12%,transparent);
  background:transparent;
}
.elementor-widget-mars_modern_faq .mars-modern-faq__item.is-open .mars-modern-faq__question{
  background:color-mix(in srgb,var(--mmf-active) 12%,var(--mmf-bg));
  color:var(--mmf-question);
  border-color:color-mix(in srgb,var(--mmf-active) 48%,transparent);
}
.elementor-widget-mars_modern_faq .mars-modern-faq__item.is-open .mars-modern-faq__question i{
  background:var(--mmf-active);
}
.elementor-widget-mars_modern_faq .mars-modern-faq__item.is-open .mars-modern-faq__question i:before,
.elementor-widget-mars_modern_faq .mars-modern-faq__item.is-open .mars-modern-faq__question i:after{
  background:var(--mmf-active-text);
}
.elementor-widget-mars_modern_faq .mars-modern-faq__answer{
  border:0!important;
  border-radius:0!important;
  background:transparent!important;
  box-shadow:none!important;
}

@media(max-width:767px){
  .elementor-widget-mars_video_introduction .mars-video-introduction{padding:16px;border-radius:24px}
}
