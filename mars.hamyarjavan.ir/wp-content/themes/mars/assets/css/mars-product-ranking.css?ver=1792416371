.elementor-widget-mars_product_ranking .elementor-widget-container { overflow: visible; }

.mars-product-ranking {
  overflow-anchor: none;
  --mars-ranking-bg: transparent;
  --mars-ranking-card-bg: transparent;
  --mars-ranking-border: transparent;
  --mars-ranking-title: #152238;
  --mars-ranking-number: #2d68df;
  --mars-ranking-divider: #c8d0dc;
  --mars-ranking-dot: #c2cad6;
  --mars-ranking-columns: 3;
  --mars-ranking-gap: 16px;
  --mars-ranking-image-radius: 12px;
  --mars-ranking-image-width: 118px;
  --mars-ranking-image-ratio: 16/9;
  --mars-ranking-image-fit: contain;
  --mars-ranking-image-position: center center;
  padding: 22px;
  background: var(--mars-ranking-bg);
  direction: rtl;
}

.mars-product-ranking__placeholder {
  padding: 22px;
  border: 1px dashed #cbd5e1;
  border-radius: 18px;
  color: #64748b;
  text-align: center;
}

.mars-product-ranking__viewport {
  overflow-anchor: none;
  overflow: visible;
}
.mars-product-ranking__track {
  display: grid;
  grid-template-columns: repeat(var(--mars-ranking-columns), minmax(0, 1fr));
  gap: var(--mars-ranking-gap);
}
.mars-product-ranking__group { display: contents; }
.mars-product-ranking__card {
  display: grid;
  grid-template-columns: var(--mars-ranking-image-width) minmax(0, 1fr) 54px;
  align-items: center;
  gap: 14px;
  min-height: 104px;
  padding: 16px 20px;
  border: 1px solid var(--mars-ranking-border);
  border-radius: 16px;
  background: var(--mars-ranking-card-bg);
  text-decoration: none !important;
  direction: ltr;
  box-sizing: border-box;
}
.mars-product-ranking__image-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--mars-ranking-image-width);
  height: auto;
  aspect-ratio: var(--mars-ranking-image-ratio);
  overflow: hidden;
  padding: 0;
  border: 0;
  border-radius: var(--mars-ranking-image-radius);
  background: transparent;
  clip-path: inset(0 round var(--mars-ranking-image-radius));
}
.mars-product-ranking__image-wrap img,
.mars-product-ranking__image {
  display: block;
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  object-fit: var(--mars-ranking-image-fit);
  object-position: var(--mars-ranking-image-position);
  border: 0;
  border-radius: var(--mars-ranking-image-radius);
  clip-path: inset(0 round var(--mars-ranking-image-radius));
}
.mars-product-ranking__title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--mars-ranking-title);
  font-size: 14px;
  font-weight: 750;
  line-height: 1.8;
  text-align: right;
  direction: rtl;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.mars-product-ranking__number {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  padding-left: 14px;
  color: var(--mars-ranking-number);
  font-size: 38px;
  font-weight: 700;
  line-height: 1;
  direction: rtl;
}
.mars-product-ranking__number::before {
  content: "";
  position: absolute;
  left: 0;
  top: 5px;
  bottom: 5px;
  width: 1px;
  background: var(--mars-ranking-divider);
}
.mars-product-ranking__dots {
  display: none;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 14px;
  direction: rtl;
}
.mars-product-ranking__dots span {
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: var(--mars-ranking-dot);
  transition: width .2s ease, background .2s ease;
}
.mars-product-ranking__dots span.is-active {
  width: 20px;
  background: var(--mars-ranking-number);
}
html[data-theme="dark"] .mars-product-ranking,
html.dark .mars-product-ranking {
  --mars-ranking-bg: transparent;
  --mars-ranking-card-bg: transparent;
  --mars-ranking-border: transparent;
  --mars-ranking-title: #f8fafc;
  --mars-ranking-number: #66a0ff;
  --mars-ranking-divider: #475569;
  --mars-ranking-dot: #526176;
}

@media (max-width: 1024px) {
  .mars-product-ranking { --mars-ranking-columns: 2; }
}

@media (max-width: 767px) {
  .mars-product-ranking { padding: 14px; }
  .mars-product-ranking__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    direction: rtl;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    touch-action: pan-x pan-y pinch-zoom;
  }
  .mars-product-ranking__viewport::-webkit-scrollbar { display: none; }
  .mars-product-ranking__track {
    display: flex;
    gap: 12px;
    min-width: 100%;
  }
  .mars-product-ranking__group {
    display: grid;
    grid-template-rows: repeat(3, auto);
    gap: 12px;
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
  }
  .mars-product-ranking__card {
    grid-template-columns: var(--mars-ranking-image-width) minmax(0, 1fr) 46px;
    min-height: 82px;
    padding: 12px 14px;
    gap: 10px;
  }
  .mars-product-ranking__image-wrap { width: var(--mars-ranking-image-width); height:auto; aspect-ratio:var(--mars-ranking-image-ratio); }
  .mars-product-ranking__title { font-size: 12.5px; }
  .mars-product-ranking__number { font-size: 30px; min-height: 42px; padding-left: 10px; }
  .mars-product-ranking__dots { display: flex; }
  .mars-product-ranking--no-dots .mars-product-ranking__dots { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .mars-product-ranking__viewport { scroll-behavior: auto; }
}


/* Reliable image radius for the product-ranking list. */
.elementor-widget-mars_product_ranking .mars-product-ranking__image-wrap,
.elementor-widget-mars_product_ranking .mars-product-ranking__image-wrap picture,
.elementor-widget-mars_product_ranking .mars-product-ranking__image-wrap img,
.elementor-widget-mars_product_ranking .mars-product-ranking__image{
	border-radius:var(--mars-ranking-image-radius)!important;
	overflow:hidden!important;
	clip-path:inset(0 round var(--mars-ranking-image-radius));
}
.elementor-widget-mars_product_ranking .mars-product-ranking__image-wrap img,
.elementor-widget-mars_product_ranking .mars-product-ranking__image{
	display:block!important;
	width:100%!important;
	height:100%!important;
	max-width:100%!important;
	max-height:100%!important;
	object-fit:var(--mars-ranking-image-fit)!important;
	object-position:var(--mars-ranking-image-position)!important;
}


/* Mars — the 12-product list is optimized for the theme's rectangular 16:9 product artwork. */
.mars-product-ranking.mars-ranking-rectangular .mars-product-ranking__card{grid-template-columns:var(--mars-ranking-image-width) minmax(0,1fr) 54px!important;min-height:calc((var(--mars-ranking-image-width) / 16 * 9) + 30px)!important}
.mars-product-ranking.mars-ranking-rectangular .mars-product-ranking__image-wrap{width:var(--mars-ranking-image-width)!important;height:auto!important;aspect-ratio:var(--mars-ranking-image-ratio)!important;background:transparent!important}
.mars-product-ranking.mars-ranking-rectangular .mars-product-ranking__image-wrap img,.mars-product-ranking.mars-ranking-rectangular .mars-product-ranking__image{width:100%!important;height:100%!important;object-fit:var(--mars-ranking-image-fit)!important;object-position:var(--mars-ranking-image-position)!important}
@media(max-width:767px){.mars-product-ranking.mars-ranking-rectangular{--mars-ranking-image-width:92px}.mars-product-ranking.mars-ranking-rectangular .mars-product-ranking__card{grid-template-columns:var(--mars-ranking-image-width) minmax(0,1fr) 46px!important;min-height:78px!important}}
