.mars-header-announcement{position:relative;z-index:1002;display:flex;width:100%;min-height:56px;align-items:center;justify-content:center;gap:14px;padding:11px clamp(48px,6vw,96px);background:var(--mars-announcement-bg,#17211b);color:var(--mars-announcement-text,#fff);text-align:center;direction:rtl}.mars-header-announcement__content{display:flex;min-width:0;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;font-size:12.5px;font-weight:800;line-height:1.9}.mars-header-announcement__message{min-width:0}.mars-header-announcement__link{display:inline-flex;min-height:32px;align-items:center;justify-content:center;padding:4px 13px;border:1px solid currentColor;border-radius:8px;background:var(--mars-announcement-link-bg,#365347);color:inherit!important;text-decoration:none!important;font-weight:950;line-height:1.5;white-space:nowrap;box-shadow:none}.mars-header-announcement__link:hover,.mars-header-announcement__link:focus,.mars-header-announcement__link:active{text-decoration:none!important;color:inherit!important;filter:brightness(1.06)}.mars-header-announcement__close{position:absolute;right:12px;left:auto;top:50%;display:grid;width:30px;height:30px;place-items:center;padding:0;border:0;border-radius:50%;background:color-mix(in srgb,currentColor 12%,transparent);color:inherit;font:700 20px/1 Arial,sans-serif;transform:translateY(-50%);cursor:pointer}.mars-header-announcement__close:hover{background:color-mix(in srgb,currentColor 20%,transparent)}.mars-header-announcement.is-dismissed{display:none!important}@media(max-width:767px){.mars-header-announcement.is-mobile-hidden{display:none!important}.mars-header-announcement{min-height:50px;padding:9px 46px}.mars-header-announcement__content{gap:8px;font-size:11.5px}.mars-header-announcement__link{min-height:30px;padding:4px 11px}.mars-header-announcement__close{right:8px;left:auto}}
