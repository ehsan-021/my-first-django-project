/* Mars — dedicated article page. */
.mars-blog-single{min-height:60vh;padding:46px 18px 70px;background:var(--mars-blog-bg,var(--mars-bg));color:var(--mars-blog-text,var(--mars-text))}.mars-blog-article{width:100%;margin:0 auto}.mars-blog-article__head-inner,.mars-blog-article__content,.mars-blog-article__tags,.mars-blog-author,.mars-blog-nav{width:min(100%,var(--mars-blog-content-width,920px));margin-inline:auto}.mars-blog-article__header{text-align:center}.mars-blog-article__meta{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:9px;margin-bottom:15px;color:var(--mars-blog-muted);font-size:11px;font-weight:750}.mars-blog-article__meta a{padding:5px 9px;border-radius:999px;background:color-mix(in srgb,var(--mars-blog-accent) 12%,transparent);color:var(--mars-blog-accent)!important;text-decoration:none!important}.mars-blog-article__header h1{max-width:980px;margin:0 auto;color:var(--mars-blog-text);font-size:clamp(30px,5vw,58px);font-weight:950;line-height:1.45;letter-spacing:-.02em}.mars-blog-article__lead{max-width:780px;margin:15px auto 0;color:var(--mars-blog-muted);font-size:15px;line-height:2}.mars-blog-article__featured{width:min(100%,1120px);margin:34px auto 40px;overflow:hidden;border-radius:26px;background:var(--mars-blog-surface)}.mars-blog-article__featured img{display:block;width:100%;height:auto;max-height:640px;object-fit:cover}.mars-blog-article__content{color:var(--mars-blog-text);font-size:16px;line-height:2.15}.mars-blog-article__content>*:first-child{margin-top:0}.mars-blog-article__content h2,.mars-blog-article__content h3,.mars-blog-article__content h4{margin:2em 0 .7em;color:var(--mars-blog-text);font-weight:950;line-height:1.7}.mars-blog-article__content h2{font-size:28px}.mars-blog-article__content h3{font-size:22px}.mars-blog-article__content p{margin:0 0 1.35em}.mars-blog-article__content a{color:var(--mars-blog-accent)!important;text-decoration-thickness:1px;text-underline-offset:4px}.mars-blog-article__content img{max-width:100%;height:auto;border-radius:18px}.mars-blog-article__content blockquote{margin:26px 0;padding:18px 20px;border-right:4px solid var(--mars-blog-accent);border-radius:14px;background:color-mix(in srgb,var(--mars-blog-accent) 7%,var(--mars-blog-surface));color:var(--mars-blog-text)}.mars-blog-article__content pre{overflow:auto;padding:18px;border:1px solid var(--mars-blog-line);border-radius:14px;background:var(--mars-blog-surface);direction:ltr;text-align:left}.mars-blog-article__content table{width:100%;border-collapse:separate;border-spacing:0;overflow:hidden;border:1px solid var(--mars-blog-line);border-radius:14px}.mars-blog-article__content th,.mars-blog-article__content td{padding:11px;border-bottom:1px solid var(--mars-blog-line);text-align:right}.mars-blog-article__tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:34px;padding-top:22px;border-top:1px solid var(--mars-blog-line)}.mars-blog-article__tags a{padding:6px 10px;border-radius:999px;background:var(--mars-blog-surface);color:var(--mars-blog-muted)!important;text-decoration:none!important;font-size:11px}.mars-blog-author{display:flex;align-items:center;gap:14px;margin-top:26px;padding:18px;border:1px solid var(--mars-blog-line);border-radius:18px;background:var(--mars-blog-surface)}.mars-blog-author img{flex:0 0 64px;width:64px;height:64px;border-radius:50%;object-fit:cover}.mars-blog-author div{display:grid;gap:2px}.mars-blog-author span{color:var(--mars-blog-muted);font-size:10px}.mars-blog-author strong{font-size:14px}.mars-blog-author p{margin:4px 0 0;color:var(--mars-blog-muted);font-size:11px;line-height:1.8}.mars-blog-nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:18px}.mars-blog-nav a{display:grid;gap:4px;padding:14px;border:1px solid var(--mars-blog-line);border-radius:15px;background:var(--mars-blog-surface);color:var(--mars-blog-text)!important;text-decoration:none!important}.mars-blog-nav span{color:var(--mars-blog-muted);font-size:9.5px}.mars-blog-nav strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11.5px}
@media(max-width:767px){.mars-blog-single{padding:30px 14px 48px}.mars-blog-article__header h1{font-size:30px}.mars-blog-article__lead{font-size:13px}.mars-blog-article__featured{margin:24px auto 30px;border-radius:18px}.mars-blog-article__content{font-size:14px;line-height:2.1}.mars-blog-article__content h2{font-size:23px}.mars-blog-nav{grid-template-columns:1fr}.mars-blog-author{align-items:flex-start}}

/* Mars — human-friendly article comments/reviews. */
.mars-blog-comments{width:min(100%,var(--mars-blog-content-width,920px));margin:34px auto 0;padding-top:30px;border-top:1px solid var(--mars-blog-line);color:var(--mars-blog-text)}
.mars-blog-comments__head{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:18px}.mars-blog-comments__head>div{display:grid;gap:5px}.mars-blog-comments__head span{color:var(--mars-blog-accent);font-size:11px;font-weight:850}.mars-blog-comments__head h2{margin:0;color:var(--mars-blog-text);font-size:clamp(20px,3vw,27px);font-weight:950;line-height:1.55}.mars-blog-comments__count{display:grid;place-items:center;min-width:46px;height:46px;padding:0 12px;border-radius:14px;background:color-mix(in srgb,var(--mars-blog-accent) 11%,var(--mars-blog-surface));color:var(--mars-blog-accent);font-size:14px;font-weight:950}
.mars-blog-comment-list,.mars-blog-comment-list .children{list-style:none;margin:0;padding:0}.mars-blog-comment-list{display:grid;gap:12px}.mars-blog-comment-list .children{display:grid;gap:10px;margin:12px 34px 0 0}.mars-blog-comment-list .comment-body{position:relative;padding:18px 18px 16px 88px;border:1px solid var(--mars-blog-line);border-radius:18px;background:var(--mars-blog-surface);box-shadow:0 8px 24px rgba(15,23,42,.035)}.mars-blog-comment-list .comment-meta{margin:0 0 8px}.mars-blog-comment-list .comment-author{display:flex;align-items:center;gap:10px}.mars-blog-comment-list .comment-author .avatar{position:absolute;top:18px;left:18px;width:54px;height:54px;border-radius:16px;object-fit:cover}.mars-blog-comment-list .comment-author .fn{color:var(--mars-blog-text);font-size:13px;font-weight:900;font-style:normal}.mars-blog-comment-list .comment-author .says{display:none}.mars-blog-comment-list .comment-metadata{margin-top:4px;color:var(--mars-blog-muted);font-size:10.5px}.mars-blog-comment-list .comment-metadata a{color:inherit!important;text-decoration:none!important}.mars-blog-comment-list .comment-content{color:var(--mars-blog-text);font-size:13.5px;line-height:2}.mars-blog-comment-list .comment-content p:last-child{margin-bottom:0}.mars-blog-comment-list .reply{margin-top:10px}.mars-blog-comment-list .comment-reply-link{display:inline-flex;padding:6px 10px;border-radius:9px;background:color-mix(in srgb,var(--mars-blog-accent) 8%,transparent);color:var(--mars-blog-accent)!important;font-size:10.5px;font-weight:850;text-decoration:none!important}.mars-blog-comments .navigation{margin-top:16px}.mars-blog-comments .nav-links{display:flex;justify-content:center;gap:7px}.mars-blog-comments .page-numbers{display:grid;place-items:center;min-width:36px;height:36px;padding:0 9px;border:1px solid var(--mars-blog-line);border-radius:10px;background:var(--mars-blog-surface);color:var(--mars-blog-text)!important;text-decoration:none!important}.mars-blog-comments .page-numbers.current{border-color:var(--mars-blog-accent);color:var(--mars-blog-accent)!important}
.mars-blog-comment-form-wrap{margin-top:22px;padding:22px;border:1px solid var(--mars-blog-line);border-radius:20px;background:color-mix(in srgb,var(--mars-blog-surface) 94%,transparent)}.mars-blog-comment-form-wrap .comment-reply-title{margin:0 0 5px;color:var(--mars-blog-text);font-size:18px;font-weight:950}.mars-blog-comment-form__note{margin:0 0 16px;color:var(--mars-blog-muted);font-size:11.5px}.mars-blog-comment-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.mars-blog-comment-form>p{margin:0}.mars-blog-comment-form .comment-form-comment,.mars-blog-comment-form .comment-form-cookies-consent,.mars-blog-comment-form .form-submit,.mars-blog-comment-form .logged-in-as{grid-column:1/-1}.mars-blog-comment-form label{display:block;margin:0 0 6px;color:var(--mars-blog-text);font-size:11.5px;font-weight:850}.mars-blog-comment-form input[type=text],.mars-blog-comment-form input[type=email],.mars-blog-comment-form input[type=url],.mars-blog-comment-form textarea{width:100%;box-sizing:border-box;padding:12px 14px;border:1px solid var(--mars-blog-line);border-radius:12px;background:var(--mars-blog-bg);color:var(--mars-blog-text);font:inherit;font-size:13px;outline:none;transition:border-color .18s ease,box-shadow .18s ease}.mars-blog-comment-form textarea{min-height:130px;resize:vertical}.mars-blog-comment-form input:focus,.mars-blog-comment-form textarea:focus{border-color:var(--mars-blog-accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--mars-blog-accent) 10%,transparent)}.mars-blog-comment-form .comment-form-cookies-consent{display:flex;align-items:flex-start;gap:8px;color:var(--mars-blog-muted);font-size:11px;line-height:1.8}.mars-blog-comment-form .comment-form-cookies-consent input{margin-top:5px}.mars-blog-comment-form .form-submit input{min-height:46px;padding:0 25px;border:0;border-radius:12px;background:var(--mars-blog-accent);color:#fff;font:inherit;font-size:13px;font-weight:900;cursor:pointer;transition:transform .18s ease,filter .18s ease}.mars-blog-comment-form .form-submit input:hover{transform:translateY(-1px);filter:brightness(1.04)}.mars-blog-comments__closed{padding:14px;border-radius:12px;background:var(--mars-blog-surface);color:var(--mars-blog-muted);text-align:center;font-size:12px}
html[data-theme="dark"] .mars-blog-comment-list .comment-body{box-shadow:none}
@media(max-width:767px){.mars-blog-comments{margin-top:26px;padding-top:24px}.mars-blog-comment-list .comment-body{padding:16px 16px 15px 72px;border-radius:15px}.mars-blog-comment-list .comment-author .avatar{top:16px;left:16px;width:44px;height:44px;border-radius:13px}.mars-blog-comment-list .children{margin-right:16px}.mars-blog-comment-form-wrap{padding:17px 14px;border-radius:16px}.mars-blog-comment-form{grid-template-columns:1fr}.mars-blog-comment-form>p{grid-column:1/-1}.mars-blog-comments__head h2{font-size:20px}}
