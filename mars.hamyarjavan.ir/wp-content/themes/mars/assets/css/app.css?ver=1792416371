.mars-submenu-toggle{position:absolute;left:0;top:10px;width:34px;height:34px;border:0;border-radius:12px;background:color-mix(in srgb,var(--mars-icon-bg,var(--mars-surface-2)) 96%,transparent);color:var(--mars-icon-color,var(--mars-text));cursor:pointer}
.mars-mobile-drawer__footer{display:flex;gap:10px;margin-top:18px}
.mars-mobile-action{display:flex!important;align-items:center;justify-content:center;gap:8px;flex:1;padding:11px 10px!important;border-radius:14px;border:1px solid color-mix(in srgb,var(--mars-header-border,var(--mars-line)) 58%,transparent);background:color-mix(in srgb,var(--mars-icon-bg,var(--mars-surface-2)) 96%,transparent);font-size:12px;cursor:pointer}
.mars-mobile-action .mars-icon{width:17px;height:17px}
html[data-theme=dark] .mars-header--accountpro{box-shadow:0 10px 38px rgba(0,0,0,.14)}
html[data-theme=dark] .mars-header-nav-panel,
html[data-theme=dark] .mars-header-search,
html[data-theme=dark] .mars-support-card,
html[data-theme=dark] .mars-icon-button,
html[data-theme=dark] .mars-account-button{border-color:rgba(255,255,255,.06)}
html[data-theme=dark] .mars-header-nav-panel .mars-menu>li>.sub-menu>li{background:rgba(255,255,255,.03)}
html[data-theme=dark] .mars-header-nav-panel .mars-menu>li>.sub-menu>li>a{color:#fff}
html[data-theme=dark] .mars-header-search input,
html[data-theme=dark] .mars-header-search input::placeholder,
html[data-theme=dark] .mars-support-card__copy strong,
html[data-theme=dark] .mars-support-card__copy span,
html[data-theme=dark] .mars-brand-block__tagline{color:#edf4ef}
html[data-theme=dark] .mars-brand-block__tagline{color:rgba(237,244,239,.72)}
html[data-theme=dark] .mars-cart-count{color:#07100d}
@media (max-width:1350px){
  .mars-header__bottom{grid-template-columns:minmax(390px,1fr) minmax(260px,.72fr) auto;gap:16px}
  .mars-header-nav-panel .mars-menu>li>a{padding:11px 12px;font-size:14px}
  .mars-header-search{height:64px}
  .mars-icon-button,.mars-account-button{height:54px}
  .mars-icon-button{width:54px}
}
@media (max-width:1120px){
  .mars-header__top{grid-template-columns:1fr}
  .mars-support-card{justify-self:end}
  .mars-header__bottom{grid-template-columns:1fr;gap:14px}
  .mars-header-actions{justify-content:flex-end}
  .mars-header-search{order:2}
  .mars-header-nav-panel{order:1}
  .mars-header-actions{order:3}
}
@media (max-width:1024px){
  .mars-header--accountpro{padding:16px 0 18px}
  .mars-header__desktop{display:none}
  .mars-mobile-header{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px}
  .mars-mobile-header__brand{display:flex;justify-content:center}
  .mars-mobile-header__brand .mars-brand__link{max-width:var(--mars-mobile-logo-width,138px)}
  .mars-mobile-header__brand .mars-mode-logo{max-height:56px}
  .mars-mobile-header__actions{display:flex;align-items:center;gap:8px}
  .mars-mobile-header .mars-icon-button{width:46px;height:46px;border-radius:16px}
  .mars-mobile-header__actions .mars-icon{width:20px;height:20px}
}
@media (max-width:640px){
  .mars-header--accountpro .mars-container{width:min(calc(100% - 20px),var(--mars-container));max-width:var(--mars-container);margin-inline:auto}
  .mars-mobile-header{grid-template-columns:auto minmax(0,1fr) auto}
  .mars-mobile-header__brand .mars-brand__link{max-width:min(var(--mars-mobile-logo-width,138px),38vw)}
  .mars-mobile-header__actions{gap:6px}
  .mars-mobile-header .mars-icon-button{width:42px;height:42px;border-radius:14px}
  .mars-mobile-drawer{padding:14px 14px 24px}
}

/* no built-in homepage content */
.mars-front-page:empty{min-height:0}

/* Mars — Elementor-built single posts render without the native article shell. */
.mars-elementor-single,.mars-elementor-single__content{width:100%;max-width:none;margin:0;padding:0;background:transparent;border:0;box-shadow:none}.mars-elementor-single__content>.elementor{width:100%}


/* Mars — currency unit is always visually left of WooCommerce prices. */
.woocommerce-Price-amount.amount bdi{display:inline-flex;align-items:baseline;gap:.28em;direction:ltr;unicode-bidi:isolate;white-space:nowrap}
.woocommerce-Price-amount.amount bdi>.woocommerce-Price-currencySymbol{order:-1}

/* Mars — compact generic WooCommerce product cards. */
.woocommerce ul.products{align-items:start!important}.woocommerce ul.products li.product{height:auto!important;align-self:start!important}.woocommerce ul.products li.product .woocommerce-loop-product__title{min-height:0!important;margin-bottom:3px!important}.woocommerce ul.products li.product .price{margin-top:0!important;margin-bottom:2px!important}
