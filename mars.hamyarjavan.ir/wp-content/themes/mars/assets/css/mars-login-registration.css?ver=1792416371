/* Mars — standalone login and default back button */
body.mars-auth-active{
	min-height:100vh!important;
	background:var(--mars-auth-page-bg,#fff)!important;
}
body.mars-auth-active #mars-site-header,
body.mars-auth-active .mars-complete-footer,
body.mars-auth-active .mars-elementor-footer{
	display:none!important;
}
body.mars-auth-active .mars-site-main{
	min-height:100vh!important;
}
.mars-account-login-form{
	position:relative;
}
.mars-account-login-back-home{
	display:inline-flex!important;
	align-items:center!important;
	justify-content:center!important;
	align-self:flex-start!important;
	gap:8px!important;
	min-height:42px!important;
	margin:0 0 28px!important;
	padding:7px 14px!important;
	border:1px solid var(--mars-auth-border,#e5e7eb)!important;
	border-radius:11px!important;
	background:transparent!important;
	color:var(--mars-auth-text,#1f2937)!important;
	font-size:13px!important;
	font-weight:900!important;
	line-height:1!important;
	text-decoration:none!important;
}
.mars-account-login-back-home:hover{
	border-color:var(--mars-auth-primary,#2f8f39)!important;
	color:var(--mars-auth-primary,#2f8f39)!important;
}
.mars-account-login-back-home span{
	font-size:18px;
	line-height:1;
}
.mars-account-login-form form.register #reg_password,
.mars-account-login-form form.register input[name="password"]{
	display:block!important;
}


/* Mars — centered default-login links */
.mars-account-login-back-home{
	align-self:center!important;
	margin:0 auto 28px!important;
	text-align:center!important;
}
.mars-account-login-form .lost_password,
.mars-account-login-form .woocommerce-LostPassword{
	display:block!important;
	width:100%!important;
	margin:14px auto 0!important;
	text-align:center!important;
}
.mars-account-login-form .lost_password a,
.mars-account-login-form .woocommerce-LostPassword a{
	display:inline-flex!important;
	align-items:center!important;
	justify-content:center!important;
	margin-inline:auto!important;
	text-align:center!important;
}
body.mars-auth-active .mars-header,body.mars-auth-active .mars-announcement,body.mars-auth-active .mars-complete-footer,body.mars-auth-active footer{display:none!important}body.mars-auth-active main#primary,body.mars-auth-active #primary,body.mars-auth-active .site-main{width:100%!important;max-width:none!important;margin:0!important;padding:0!important}

/* Authentication-page centering and page-title cleanup. */
body.mars-auth-active .mars-content-card>header,body.mars-auth-active .mars-content-card>.mars-page-header{display:none!important}
body.mars-auth-mode-sms .woocommerce{display:flex!important;width:100%!important;min-height:100svh!important;align-items:center!important;justify-content:center!important;margin:0!important;padding:0!important}
body.mars-auth-mode-sms .woocommerce>.mars-sms-auth-wrap{width:100%!important;min-height:100svh!important}


/* Mars — remove native Woo account chrome from the dedicated auth screen. */
body.mars-auth-active #customer_login>.u-column1>h2,
body.mars-auth-active #customer_login>.u-column2>h2,
body.mars-auth-active #customer_login>.col-1>h2,
body.mars-auth-active #customer_login>.col-2>h2,
body.mars-auth-active .woocommerce>h2,
body.mars-auth-active .woocommerce-breadcrumb,
body.mars-auth-active nav.woocommerce-breadcrumb{display:none!important}
body.mars-auth-active .mars-mobile-overlay,
body.mars-auth-active .mars-mobile-drawer,
body.mars-auth-active .mars-skip-link{display:none!important}

/* Mars — SMS/password hybrid authentication */
.mars-sms-auth-logo{margin-bottom:22px}
.mars-sms-login-tabs{
	display:grid;
	grid-template-columns:repeat(2,minmax(0,1fr));
	gap:5px;
	margin:0 0 28px;
	padding:5px;
	border:1px solid var(--mars-auth-border,#e5e7eb);
	border-radius:13px;
	background:color-mix(in srgb,var(--mars-auth-border,#e5e7eb) 36%,transparent);
}
.mars-sms-login-tabs button{
	min-height:42px;
	padding:7px 10px;
	border:0;
	border-radius:9px;
	background:transparent;
	color:var(--mars-auth-muted,#7c8798);
	font-family:inherit;
	font-size:13px;
	font-weight:900;
	cursor:pointer;
	transition:background .18s ease,color .18s ease,box-shadow .18s ease;
}
.mars-sms-login-tabs button.is-active{
	background:var(--mars-auth-card-bg,#fff);
	color:var(--mars-auth-primary,#ef4056);
	box-shadow:0 2px 10px rgba(15,23,42,.07);
}
.mars-sms-password-fields{
	display:grid;
	gap:12px;
	margin-top:14px;
}
.mars-sms-password-fields[hidden]{display:none!important}
.mars-sms-password-fields .mars-sms-field{margin:0}
.mars-sms-secondary{
	width:100%;
	min-height:50px;
	padding:9px 16px;
	border:1px solid var(--mars-auth-primary,#ef4056);
	border-radius:10px;
	background:transparent;
	color:var(--mars-auth-primary,#ef4056);
	font-family:inherit;
	font-size:14px;
	font-weight:950;
	cursor:pointer;
}
.mars-sms-secondary:hover{
	background:color-mix(in srgb,var(--mars-auth-primary,#ef4056) 8%,transparent);
}
.mars-sms-secondary[disabled]{opacity:.65;cursor:not-allowed}
.mars-sms-auth-step[data-mars-sms-step="password"] .mars-sms-field input[readonly]{
	background:color-mix(in srgb,var(--mars-auth-input-bg,#fff) 78%,var(--mars-auth-border,#e5e7eb));
	cursor:default;
}
@media(max-width:600px){
	.mars-sms-login-tabs{margin-bottom:24px}
	.mars-sms-login-tabs button{font-size:12px;padding-inline:6px}
}

/* Safari fallback after a successfully authenticated SMS login. */
.mars-sms-auth-message a{color:inherit;text-decoration:underline;font-weight:700;margin-inline-start:4px}

/* Registration identity fields: shown only for mobile numbers without an account. */
.mars-sms-register-label{display:block;margin:0 3px 7px;text-align:right;color:var(--mars-auth-text,#1f2937);font-size:13px;font-weight:850}
.mars-sms-auth-step[data-mars-sms-step="register"] .mars-sms-field{margin-bottom:16px}
.mars-sms-auth-step[data-mars-sms-step="register"] .mars-sms-field input{text-align:right!important;padding:0 15px!important}
.mars-sms-auth-step .mars-sms-register-hint{margin:0 0 20px!important;font-size:12px!important;line-height:1.9!important}
.mars-sms-register-edit{margin:17px auto 0!important}
