/* Mars header bundle — ordered component cascade in one request. */

/* Header component layer. */
/* Mars — unified container, aligned header and refined mega/mobile menus */
:root{
  --mars-container:1280px;
  --mars-font-fa:"Mars Peyda","PeydaWebFaNum",Tahoma,"Segoe UI",Arial,sans-serif;
  --mars-font-latin:"Mars Inter",Inter,Arial,sans-serif;
}
html,body{width:100%;max-width:100%;overflow-x:clip}
body,button,input,select,textarea{font-family:var(--mars-font-fa)!important}
body{font-weight:500;font-feature-settings:"ss01" 1,"ss02" 1}
code,kbd,pre,.mars-latin{font-family:var(--mars-font-latin)!important}
.mars-container{width:min(calc(100% - 40px),var(--mars-container))!important;max-width:var(--mars-container)!important;margin-inline:auto!important;padding-inline:0!important}
.mars-header--accountpro>.mars-container.mars-header__shell{width:min(calc(100% - 40px),var(--mars-container))!important;max-width:var(--mars-container)!important;margin-inline:auto!important;padding-inline:0!important}
.mars-header,.mars-header *{box-sizing:border-box}
body.admin-bar .mars-header.is-sticky{top:32px}

/* Header frame */
.mars-header--accountpro{position:relative!important;width:100%!important;max-width:100%!important;margin:0!important;padding:30px 0 30px!important;background:var(--mars-header-bg,var(--mars-bg))!important;border:0!important;overflow:visible!important;box-shadow:none!important;backdrop-filter:none!important;z-index:1000!important}
.mars-header__shell,.mars-header__desktop,.mars-header__top,.mars-header__bottom{width:100%!important;max-width:100%!important;min-width:0!important}
.mars-header__desktop{display:block!important}

/* One shared 3-column geometry for both rows: left / center / right. */
.mars-header__top{display:flex!important;align-items:flex-start!important;justify-content:space-between!important;gap:24px!important;margin:0 0 22px!important;direction:rtl!important}
.mars-brand-block{flex:0 0 auto!important;min-width:0!important;display:grid!important;justify-items:end!important;gap:7px!important;direction:rtl!important}
.mars-brand{display:flex!important;justify-content:flex-end!important;max-width:100%!important;min-width:0!important}
.mars-brand__link{display:inline-flex!important;align-items:center!important;justify-content:flex-end!important;width:auto!important;max-width:min(var(--mars-logo-width,210px),100%)!important;line-height:1!important}
.mars-brand__link img{display:block!important;width:auto!important;height:auto!important;max-width:100%!important;max-height:76px!important;object-fit:contain!important}
.mars-brand__link .mars-logo-dark{display:none!important}
html[data-theme=dark] .mars-brand__link .mars-logo-light{display:none!important}
html[data-theme=dark] .mars-brand__link .mars-logo-dark{display:block!important}
.mars-brand__link .mars-logo-universal{display:block!important}
.mars-brand__text{font-size:28px!important;font-weight:900!important;color:var(--mars-menu-text,var(--mars-text))!important;white-space:nowrap!important}
.mars-brand-block__tagline{margin:0!important;font-size:14px!important;font-weight:500!important;line-height:1.9!important;color:color-mix(in srgb,var(--mars-menu-text,var(--mars-text)) 62%,transparent)!important}

.mars-support-card{flex:0 0 280px!important;width:280px!important;display:flex!important;align-items:center!important;gap:12px!important;min-width:240px!important;max-width:310px!important;padding:12px 15px!important;border-radius:24px!important;background:color-mix(in srgb,var(--mars-surface-2) 20%,transparent)!important;border:1px solid color-mix(in srgb,var(--mars-header-border,var(--mars-line)) 30%,transparent)!important;color:var(--mars-menu-text,var(--mars-text))!important;box-shadow:0 10px 28px rgba(0,0,0,.035)!important;backdrop-filter:blur(18px) saturate(110%)!important;-webkit-backdrop-filter:blur(18px) saturate(110%)!important;text-decoration:none!important;direction:rtl!important;transition:background-color .18s,border-color .18s!important}
.mars-support-card:hover{background:color-mix(in srgb,var(--mars-surface-2) 30%,transparent)!important;border-color:color-mix(in srgb,var(--mars-accent) 28%,transparent)!important;color:var(--mars-menu-text,var(--mars-text))!important}
.mars-support-card__icon{display:grid!important;place-items:center!important;flex:0 0 56px!important;width:56px!important;height:56px!important}
.mars-support-card__icon img{display:block!important;width:56px!important;height:56px!important;object-fit:contain!important}
.mars-support-card__copy{display:grid!important;gap:2px!important;min-width:0!important;text-align:right!important}
.mars-support-card__copy strong{font-size:15px!important;font-weight:900!important;line-height:1.55!important;white-space:nowrap!important;color:inherit!important}
.mars-support-card__copy span{font-size:13px!important;font-weight:700!important;line-height:1.75!important;white-space:nowrap!important;color:color-mix(in srgb,currentColor 82%,transparent)!important}
html[data-theme=dark] .mars-support-card{background:rgba(255,255,255,.035)!important;border-color:rgba(255,255,255,.055)!important}

/* Bottom row: right menu + left tool cluster, matching the reference alignment. */
.mars-header__bottom{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:28px!important;direction:rtl!important;min-width:0!important}
.mars-primary-nav{flex:0 1 auto!important;min-width:0!important;width:max-content!important;max-width:calc(100% - 610px)!important;direction:rtl!important}
.mars-header-tools{flex:0 0 auto!important;display:flex!important;align-items:center!important;gap:12px!important;direction:rtl!important;min-width:0!important;margin:0!important}
.mars-header-nav-panel{position:relative!important;min-width:0!important;width:max-content!important;max-width:100%!important;padding:0 14px!important;border-radius:25px!important;background:color-mix(in srgb,var(--mars-surface-2) 67%,transparent)!important;border:1px solid color-mix(in srgb,var(--mars-header-border,var(--mars-line)) 32%,transparent)!important;box-shadow:none!important;backdrop-filter:blur(12px)!important;-webkit-backdrop-filter:blur(12px)!important;direction:rtl!important;overflow:visible!important}
.mars-header-nav-panel .mars-menu,.mars-header-nav-panel .mars-menu ul{list-style:none!important;margin:0!important;padding:0!important}
.mars-header-nav-panel .mars-menu{display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:3px!important;min-height:62px!important;max-width:100%!important;direction:rtl!important;white-space:nowrap!important;overflow:visible!important}
.mars-header-nav-panel .mars-menu>li{position:static!important;flex:0 0 auto!important;margin:0!important}
.mars-header-nav-panel .mars-menu>li>a{display:flex!important;align-items:center!important;gap:7px!important;padding:10px 13px!important;border-radius:17px!important;background:transparent!important;color:var(--mars-menu-text,var(--mars-text))!important;font-size:13px!important;font-weight:800!important;line-height:1.75!important;white-space:nowrap!important;transition:background-color .18s,color .18s!important;direction:rtl!important}
.mars-header-nav-panel .mars-menu>li:hover>a,.mars-header-nav-panel .mars-menu>li:focus-within>a,.mars-header-nav-panel .mars-menu>.current-menu-item>a,.mars-header-nav-panel .mars-menu>.current-menu-parent>a,.mars-header-nav-panel .mars-menu>.current-menu-ancestor>a{background:color-mix(in srgb,var(--mars-menu-hover-bg,var(--mars-surface-2)) 68%,transparent)!important;color:var(--mars-menu-hover,var(--mars-accent))!important}
.mars-header-nav-panel .mars-menu>.current-menu-item>a{font-weight:900!important}
.mars-header-nav-panel .mars-menu>li.menu-item-has-children>a:after{content:""!important;display:inline-block!important;width:8px!important;height:8px!important;margin-right:4px!important;border-right:2px solid currentColor!important;border-bottom:2px solid currentColor!important;transform:rotate(45deg) translateY(-2px)!important;flex:0 0 auto!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>a:after,.mars-header-nav-panel .mars-menu>li>.sub-menu>li>a:before{content:none!important;display:none!important}
.mars-menu-item-icon{display:inline-flex!important;align-items:center!important;justify-content:center!important;width:17px!important;height:17px!important;flex:0 0 17px!important;color:currentColor!important}
.mars-menu-item-icon svg{width:100%!important;height:100%!important;fill:currentColor!important;stroke:none!important}
.mars-pack-icon[data-mars-icon="chatgpt"] svg,.mars-pack-icon[data-mars-icon="ai"] svg,.mars-pack-icon[data-mars-icon="sparkles-ai"] svg{fill:none!important;stroke:currentColor!important;stroke-linecap:round!important;stroke-linejoin:round!important}
.mars-pack-icon[data-mars-icon="chatgpt"] svg{stroke-width:4.2!important}
.mars-pack-icon[data-mars-icon="ai"] svg,.mars-pack-icon[data-mars-icon="sparkles-ai"] svg{stroke-width:4!important}

/* Mega menu: light uses light surfaces; dark follows dark theme variables. */
.mars-header-nav-panel .mars-menu>li>.sub-menu{--mars-mega-cols:4;--mars-mega-width:1040px;position:absolute!important;top:calc(100% + 14px)!important;right:0!important;left:auto!important;width:min(var(--mars-mega-width),var(--mars-container),calc(100vw - 40px))!important;max-width:calc(100vw - 40px)!important;min-width:0!important;display:grid!important;grid-template-columns:repeat(var(--mars-mega-cols),minmax(0,1fr))!important;align-items:stretch!important;gap:18px!important;padding:20px!important;border-radius:28px!important;background:color-mix(in srgb,var(--mars-surface) 96%,var(--mars-bg))!important;border:1px solid color-mix(in srgb,var(--mars-line) 88%,transparent)!important;box-shadow:0 26px 72px rgba(30,48,39,.13)!important;opacity:0!important;visibility:hidden!important;pointer-events:none!important;transform:translateY(8px)!important;transition:opacity .18s,visibility .18s,transform .18s!important;z-index:90!important;overflow-x:hidden!important;direction:rtl!important}
.mars-header-nav-panel .mars-menu>li.mars-mega-columns-1>.sub-menu{--mars-mega-cols:1;--mars-mega-width:270px}
.mars-header-nav-panel .mars-menu>li.mars-mega-columns-2>.sub-menu{--mars-mega-cols:2;--mars-mega-width:530px}
.mars-header-nav-panel .mars-menu>li.mars-mega-columns-3>.sub-menu{--mars-mega-cols:3;--mars-mega-width:790px}
.mars-header-nav-panel .mars-menu>li.mars-mega-columns-4>.sub-menu{--mars-mega-cols:4;--mars-mega-width:1040px}
.mars-header-nav-panel .mars-menu>li.mars-mega-overflow>.sub-menu{max-height:560px!important;overflow-y:auto!important;overscroll-behavior:contain!important;scrollbar-width:thin!important;scrollbar-color:color-mix(in srgb,var(--mars-accent) 65%,transparent) transparent!important}
.mars-header-nav-panel .mars-menu>li.mars-mega-overflow>.sub-menu::-webkit-scrollbar{width:6px}
.mars-header-nav-panel .mars-menu>li.mars-mega-overflow>.sub-menu::-webkit-scrollbar-thumb{background:color-mix(in srgb,var(--mars-accent) 65%,transparent);border-radius:999px}
.mars-header-nav-panel .mars-menu>li:hover>.sub-menu,.mars-header-nav-panel .mars-menu>li:focus-within>.sub-menu{opacity:1!important;visibility:visible!important;pointer-events:auto!important;transform:none!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li{display:flex!important;flex-direction:column!important;min-width:0!important;min-height:355px!important;padding:0!important;margin:0!important;border-radius:0!important;background:transparent!important;color:var(--mars-text)!important;direction:rtl!important;text-align:right!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>a{display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:10px!important;min-height:52px!important;margin:0!important;padding:0 8px 10px!important;border-radius:0!important;background:transparent!important;color:var(--mars-text)!important;font-size:14px!important;font-weight:700!important;line-height:1.8!important;white-space:normal!important;direction:rtl!important;text-align:right!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>a:hover{color:var(--mars-accent)!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>a .mars-menu-item-icon{width:20px!important;height:20px!important;flex-basis:20px!important;color:var(--mars-accent)!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>.sub-menu{position:static!important;display:flex!important;flex-direction:column!important;flex:1 1 auto!important;gap:0!important;min-width:0!important;min-height:300px!important;padding:18px 18px 16px!important;margin:0!important;border:1px solid color-mix(in srgb,var(--mars-line) 70%,transparent)!important;border-radius:18px!important;background:color-mix(in srgb,var(--mars-accent) 4%,var(--mars-surface-2))!important;box-shadow:none!important;opacity:1!important;visibility:visible!important;pointer-events:auto!important;transform:none!important;overflow:hidden!important;direction:rtl!important;text-align:right!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>.sub-menu>li{position:static!important;margin:0!important;padding:0!important;border:0!important;background:transparent!important;text-align:right!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>.sub-menu>li>a{display:block!important;padding:5px 0!important;border-radius:0!important;background:transparent!important;color:color-mix(in srgb,var(--mars-text) 90%,transparent)!important;font-size:13px!important;font-weight:500!important;line-height:1.9!important;white-space:normal!important;transition:color .16s!important;text-align:right!important;direction:rtl!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>.sub-menu>li>a:hover{color:var(--mars-accent)!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>.sub-menu>.mars-mega-view-all-item{margin-top:auto!important;padding-top:18px!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>.sub-menu>.mars-mega-view-all-item>a{display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:8px!important;color:var(--mars-text)!important;font-size:13px!important;font-weight:700!important;direction:rtl!important;text-align:right!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>.sub-menu>.mars-mega-view-all-item>a .mars-view-all-arrow{display:inline-flex!important;align-items:center!important;justify-content:center!important;width:18px!important;height:18px!important;color:var(--mars-accent)!important;line-height:1!important;flex:0 0 18px!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>.sub-menu>.mars-mega-view-all-item>a .mars-view-all-arrow svg{display:block!important;width:18px!important;height:18px!important;fill:none!important;stroke:currentColor!important;stroke-width:2!important;stroke-linecap:round!important;stroke-linejoin:round!important}
.mars-header-nav-panel .mars-menu>li>.sub-menu>li>.sub-menu>.mars-mega-view-all-item>a:hover{color:var(--mars-accent)!important}
html[data-theme=dark] .mars-header-nav-panel .mars-menu>li>.sub-menu{background:color-mix(in srgb,var(--mars-submenu-bg,var(--mars-surface)) 96%,#0b0d0c)!important;border-color:rgba(255,255,255,.055)!important;box-shadow:0 30px 80px rgba(0,0,0,.30)!important}
html[data-theme=dark] .mars-header-nav-panel .mars-menu>li>.sub-menu>li>.sub-menu{background:rgba(255,255,255,.035)!important;border-color:rgba(255,255,255,.045)!important}

/* Search sits immediately beside the left action group. */
.mars-header-search{flex:0 0 300px!important;position:static!important;inset:auto!important;z-index:auto!important;width:300px!important;max-width:300px!important;min-width:230px!important;height:62px!important;display:grid!important;grid-template-columns:42px minmax(0,1fr)!important;align-items:center!important;gap:8px!important;padding:0 14px!important;margin:0!important;border-radius:23px!important;background:color-mix(in srgb,var(--mars-surface-2) 67%,transparent)!important;border:1px solid color-mix(in srgb,var(--mars-header-border,var(--mars-line)) 32%,transparent)!important;box-shadow:none!important;backdrop-filter:blur(12px)!important;-webkit-backdrop-filter:blur(12px)!important;direction:ltr!important}
.mars-header-search button{display:grid!important;place-items:center!important;width:40px!important;height:40px!important;padding:0!important;margin:0!important;border:0!important;border-radius:13px!important;background:transparent!important;color:var(--mars-icon-color,var(--mars-text))!important;cursor:pointer!important}
.mars-header-search button:hover{background:var(--mars-icon-hover-bg,var(--mars-surface-2))!important;color:var(--mars-icon-hover,var(--mars-accent))!important}
.mars-header-search button .mars-icon{width:19px!important;height:19px!important}
.mars-header-search input{display:block!important;width:100%!important;min-width:0!important;height:auto!important;margin:0!important;padding:0!important;border:0!important;outline:0!important;background:transparent!important;box-shadow:none!important;color:var(--mars-menu-text,var(--mars-text))!important;font:inherit!important;font-size:13px!important;font-weight:700!important;line-height:1.8!important;text-align:right!important;direction:rtl!important}
.mars-header-search input::placeholder{color:color-mix(in srgb,var(--mars-menu-text,var(--mars-text)) 52%,transparent)!important;opacity:1!important}

/* Actions align vertically with the support card above. */
.mars-header-actions{flex:0 0 280px!important;width:280px!important;display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:8px!important;direction:rtl!important;min-width:0!important;white-space:nowrap!important;margin:0!important}
.mars-account-button{display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:8px!important;height:52px!important;min-height:52px!important;padding:0 16px!important;margin:0!important;border-radius:18px!important;border:1px solid color-mix(in srgb,var(--mars-header-border,var(--mars-line)) 32%,transparent)!important;background:color-mix(in srgb,var(--mars-account-bg,var(--mars-surface-2)) 78%,transparent)!important;color:var(--mars-account-text,#fff)!important;box-shadow:none!important;backdrop-filter:blur(12px)!important;font-size:13px!important;font-weight:900!important;line-height:1!important;transition:background-color .18s,color .18s!important}
.mars-account-button:hover{background:var(--mars-account-hover,var(--mars-account-bg))!important;color:var(--mars-account-text,#fff)!important;transform:none!important}
.mars-account-button .mars-icon{width:19px!important;height:19px!important}
.mars-icon-button{position:relative!important;display:grid!important;place-items:center!important;width:52px!important;height:52px!important;min-width:52px!important;min-height:52px!important;padding:0!important;margin:0!important;border-radius:18px!important;border:1px solid color-mix(in srgb,var(--mars-header-border,var(--mars-line)) 32%,transparent)!important;background:color-mix(in srgb,var(--mars-icon-bg,var(--mars-surface-2)) 70%,transparent)!important;color:var(--mars-icon-color,var(--mars-text))!important;box-shadow:none!important;backdrop-filter:blur(12px)!important;cursor:pointer!important;transition:background-color .18s,color .18s!important}
.mars-icon-button:hover{background:var(--mars-icon-hover-bg,var(--mars-surface-2))!important;color:var(--mars-icon-hover,var(--mars-accent))!important;transform:none!important}
.mars-icon-button>.mars-icon{display:flex!important;align-items:center!important;justify-content:center!important;width:20px!important;height:20px!important;margin:0!important}
.mars-theme-toggle{position:relative!important;overflow:hidden!important}
.mars-theme-toggle .mars-theme-icon-light,.mars-theme-toggle .mars-theme-icon-dark{position:absolute!important;inset:0!important;display:flex!important;align-items:center!important;justify-content:center!important;width:100%!important;height:100%!important;margin:0!important;padding:0!important;line-height:1!important}
.mars-theme-toggle .mars-theme-icon-dark{display:none!important}
html[data-theme=dark] .mars-theme-toggle .mars-theme-icon-light{display:none!important}
html[data-theme=dark] .mars-theme-toggle .mars-theme-icon-dark{display:flex!important}
.mars-theme-toggle .mars-icon{display:flex!important;align-items:center!important;justify-content:center!important;width:20px!important;height:20px!important;margin:0!important;transform:none!important}
.mars-cart-count{position:absolute!important;top:-5px!important;left:-5px!important;display:grid!important;place-items:center!important;min-width:21px!important;height:21px!important;padding:0 5px!important;border-radius:999px!important;background:var(--mars-accent)!important;color:#06100c!important;font-size:10px!important;font-weight:900!important;line-height:1!important}

/* Mobile drawer */
.mars-mobile-header{display:none!important}
.mars-mobile-overlay{position:fixed!important;inset:0!important;background:rgba(0,0,0,.5)!important;backdrop-filter:blur(4px)!important;opacity:0!important;transition:.18s!important;z-index:10000!important}
.mars-mobile-overlay.is-open{opacity:1!important}
.mars-mobile-drawer{display:block!important;position:fixed!important;top:0!important;right:0!important;left:auto!important;width:min(88vw,370px)!important;max-width:370px!important;height:100dvh!important;padding:18px!important;background:var(--mars-header-bg,var(--mars-surface))!important;color:var(--mars-menu-text,var(--mars-text))!important;border:0!important;border-left:1px solid var(--mars-header-border,var(--mars-line))!important;box-shadow:-24px 0 70px rgba(0,0,0,.28)!important;transform:translateX(105%)!important;transition:transform .2s!important;z-index:10001!important;overflow-y:auto!important;overflow-x:hidden!important}
.mars-mobile-drawer.is-open{transform:none!important}
.mars-mobile-drawer__head{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;margin-bottom:14px!important;direction:rtl!important}
.mars-mobile-drawer__logo .mars-brand__link{max-width:var(--mars-mobile-logo-width,138px)!important}
.mars-mobile-drawer__logo img{display:block!important;max-width:100%!important;max-height:52px!important;object-fit:contain!important}
.mars-mobile-drawer__tagline{margin:0 0 12px!important;color:var(--mars-muted)!important;font-size:12px!important;line-height:1.9!important}
