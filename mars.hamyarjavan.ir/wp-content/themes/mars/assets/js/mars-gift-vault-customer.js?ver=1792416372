(function(){'use strict';document.addEventListener('click',function(e){var btn=e.target.closest('.mars-gv-copy');if(!btn)return;var code=btn.getAttribute('data-code');var previous=btn.textContent;var done=function(){btn.textContent='کپی شد';setTimeout(function(){btn.textContent=previous;},1800);};if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(code).then(done).catch(function(){window.prompt('کد را کپی کنید:',code);});}else{window.prompt('کد را کپی کنید:',code);}});})();
