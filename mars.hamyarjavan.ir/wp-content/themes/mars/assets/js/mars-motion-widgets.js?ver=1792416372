(function(){'use strict';
function faNumber(value){var n=Number(value);if(!isFinite(n))n=0;var decimals=Math.abs(n-Math.round(n))>0.0001?1:0;try{return n.toLocaleString('fa-IR',{maximumFractionDigits:decimals,minimumFractionDigits:decimals});}catch(e){return String(n).replace(/\d/g,function(d){return '۰۱۲۳۴۵۶۷۸۹'[d];});}}
function animate(root){if(!root||root.dataset.marsCounted==='1')return;root.dataset.marsCounted='1';var duration=Math.max(400,parseInt(root.getAttribute('data-duration')||'1800',10));root.querySelectorAll('[data-target]').forEach(function(el){var target=parseFloat(el.getAttribute('data-target')||'0'),start=performance.now();function tick(now){var p=Math.min(1,(now-start)/duration),e=1-Math.pow(1-p,3);el.textContent=faNumber(Math.round(target*e));if(p<1)requestAnimationFrame(tick);else el.textContent=faNumber(target);}requestAnimationFrame(tick);});}
function init(){document.querySelectorAll('[data-mars-animated-stats]').forEach(function(root){if('IntersectionObserver'in window){var io=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(entry.isIntersecting){animate(root);io.disconnect();}});},{threshold:.25});io.observe(root);}else animate(root);});document.querySelectorAll('.mars-loop-video video').forEach(function(v){v.muted=true;v.defaultMuted=true;v.loop=true;v.playsInline=true;var p=v.play();if(p&&p.catch)p.catch(function(){});});}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
if(window.elementorFrontend&&window.elementorFrontend.hooks){window.elementorFrontend.hooks.addAction('frontend/element_ready/mars_animated_statistics.default',init);window.elementorFrontend.hooks.addAction('frontend/element_ready/mars_loop_video.default',init);}
})();
