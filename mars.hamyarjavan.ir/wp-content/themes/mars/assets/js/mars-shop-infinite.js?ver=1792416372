/**
 * Mars shop infinite scroll – extend the native WooCommerce archive grid.
 * The public JSON response is based on the same filtered main shop query.
 */
(function () {
  'use strict';

  function start() {
    var status = document.getElementById('mars-shop-scroll-status');
    if (!window.fetch || !window.URL) return;
    if (!status) {
      // On a directly opened last /page/N/ URL there may be no next batch.
      if (document.querySelector('#primary ul.products')) {
        document.body.classList.add('mars-shop-scroll-ready');
      }
      return;
    }

    // WooCommerce renders its archive product grid immediately before the
    // woocommerce_after_shop_loop hook that outputs the status element.
    var grid = status.previousElementSibling;
    if (!grid || !grid.matches('ul.products, ol.products')) return;

    var nextOffset = Number(status.dataset.nextOffset);
    var batch = Number(status.dataset.batch);
    var total = Number(status.dataset.total);
    if (!Number.isFinite(nextOffset) || !Number.isFinite(batch) || !Number.isFinite(total) ||
        batch < 1 || nextOffset >= total) return;

    var loader = status.querySelector('.mars-shop-scroll-loading');
    var retry = status.querySelector('.mars-shop-scroll-retry');
    var busy = false;
    var completed = false;
    var observer = null;
    var checkScheduled = false;
    var preloadDistance = 350;

    function setLoading(value) {
      busy = value;
      if (loader) loader.hidden = !value;
      status.setAttribute('aria-busy', value ? 'true' : 'false');
    }

    function finish() {
      completed = true;
      setLoading(false);
      if (observer) observer.disconnect();
      window.removeEventListener('scroll', scheduleCheck);
      window.removeEventListener('resize', scheduleCheck);
      status.hidden = true;
    }

    // IntersectionObserver only notifies us when the sentinel changes its
    // intersection state. If the sentinel REMAINS in view while a batch loads,
    // another notification may never occur. Recheck its actual position after
    // every batch and on subsequent scrolls instead of relying on new entries.
    function checkPosition() {
      if (busy || completed || (retry && !retry.hidden)) return;
      var bounds = status.getBoundingClientRect();
      var viewportHeight = window.innerHeight || document.documentElement.clientHeight;
      if (bounds.top <= viewportHeight + preloadDistance && bounds.bottom >= -preloadDistance) {
        loadMore();
      }
    }

    function scheduleCheck() {
      if (checkScheduled || busy || completed || (retry && !retry.hidden)) return;
      checkScheduled = true;
      window.requestAnimationFrame(function () {
        checkScheduled = false;
        checkPosition();
      });
    }

    function loadMore() {
      if (busy || completed || nextOffset >= total) return;
      if (retry) retry.hidden = true;
      setLoading(true);

      var url = new URL(window.location.href);
      url.searchParams.set('mars_scroll_batch', '1');
      url.searchParams.set('mars_scroll_offset', String(nextOffset));

      fetch(url.toString(), {
        method: 'GET',
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
      })
        .then(function (response) {
          if (!response.ok) throw new Error('Shop batch HTTP ' + response.status);
          return response.json();
        })
        .then(function (json) {
          if (!json || !json.success || !json.data) throw new Error('Invalid shop batch');
          var data = json.data;
          if (typeof data.html !== 'string' || !Number.isFinite(Number(data.nextOffset)) ||
              Number(data.nextOffset) <= nextOffset) throw new Error('Invalid shop batch data');

          var template = document.createElement('template');
          template.innerHTML = data.html.trim();
          var cards = Array.prototype.slice.call(template.content.querySelectorAll('li.product'));
          if (!cards.length && data.hasMore) throw new Error('Empty shop batch');

          var fragment = document.createDocumentFragment();
          cards.forEach(function (card) { fragment.appendChild(card); });
          grid.appendChild(fragment);
          nextOffset = Number(data.nextOffset);
          total = Number(data.total) || total;

          // Integrations can initialize their own behavior for appended cards.
          document.dispatchEvent(new CustomEvent('mars:shop-products-loaded', {
            detail: { cards: cards, grid: grid }
          }));
          if (window.jQuery) {
            window.jQuery(document.body).trigger('mars_shop_products_loaded', [cards, grid]);
          }

          if (!data.hasMore || nextOffset >= total) {
            finish();
          } else {
            setLoading(false);
            // Critical: immediately re-arm after the DOM expands. If the user
            // is still near the new bottom, fetch the next batch without
            // requiring an artificial scroll up and down.
            scheduleCheck();
          }
        })
        .catch(function () {
          setLoading(false);
          // Do not retry automatically on network errors.
          if (retry) retry.hidden = false;
        });
    }

    if (retry) retry.addEventListener('click', loadMore);
    document.body.classList.add('mars-shop-scroll-ready');

    // Keep scroll/resize checks even in browsers with IntersectionObserver.
    // They reliably re-arm loading when a sentinel remains intersecting.
    window.addEventListener('scroll', scheduleCheck, { passive: true });
    window.addEventListener('resize', scheduleCheck, { passive: true });
    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver(function (entries) {
        if (entries.some(function (entry) { return entry.isIntersecting; })) scheduleCheck();
      }, { rootMargin: preloadDistance + 'px 0px', threshold: 0 });
      observer.observe(status);
    }
    scheduleCheck();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
