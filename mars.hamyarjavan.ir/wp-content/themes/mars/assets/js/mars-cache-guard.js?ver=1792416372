(function (window, document, $) {
  'use strict';

  // A page restored from the browser back/forward cache is a frozen snapshot.
  // Dynamic Mars pages must be re-requested instead of showing that snapshot.
  window.addEventListener('pageshow', function (event) {
    if (event && event.persisted) {
      window.location.reload();
    }
  });

  // Prevent jQuery from reusing a cached GET response for same-origin dynamic
  // requests and ask intermediary caches to revalidate/no-store it.
  if ($ && $.ajaxPrefilter) {
    $.ajaxPrefilter(function (options, originalOptions, jqXHR) {
      var url = String(options.url || window.location.href);
      try {
        var parsed = new URL(url, window.location.href);
        if (parsed.origin !== window.location.origin) return;
      } catch (e) {
        return;
      }
      options.cache = false;
      try {
        jqXHR.setRequestHeader('Cache-Control', 'no-cache, no-store, max-age=0');
        jqXHR.setRequestHeader('Pragma', 'no-cache');
      } catch (e) {}
    });
  }

  // WooCommerce cart fragments normally use browser storage as a performance
  // cache. Force one live refresh on page load so the header/cart badge cannot
  // survive with an old quantity after cart mutations or backend changes.
  if ($) {
    $(function () {
      if (window.wc_cart_fragments_params || document.querySelector('.mars-cart-count')) {
        window.setTimeout(function () {
          $(document.body).trigger('wc_fragment_refresh');
        }, 30);
      }
    });
  }

  // Tell the browser not to keep dynamically rendered forms/pages in its own
  // form restoration cache when navigating away and back.
  if ('scrollRestoration' in window.history) {
    window.history.scrollRestoration = 'auto';
  }
})(window, document, window.jQuery);
