(function () {
  'use strict';

  function clamp(value, min, max) {
    return Math.max(min, Math.min(max, value));
  }

  function initSlider(root) {
    if (!root || root.dataset.marsSliderReady === '1') return;

    var viewport = root.querySelector('.mars-image-slider__viewport');
    var slides = Array.prototype.slice.call(root.querySelectorAll('.mars-image-slider__slide'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-slider-dot]'));
    var previous = root.querySelector('[data-slider-prev]');
    var next = root.querySelector('[data-slider-next]');

    if (!viewport || !slides.length) return;

    root.dataset.marsSliderReady = '1';

    var current = 0;
    var timer = 0;
    var visible = true;
    var pointerDown = false;
    var pointerStartX = 0;
    var pointerStartScroll = 0;
    var dragged = false;
    var scrollFrame = 0;
    var animationFrame = 0;
    var autoplay = root.dataset.autoplay === '1' && slides.length > 1;
    var loop = root.dataset.loop === '1';
    var pauseHover = root.dataset.pauseHover === '1';
    var dragEnabled = root.dataset.drag === '1';
    var sizingMode = root.dataset.sizingMode === 'natural' ? 'natural' : 'fixed';
    var delay = Math.max(1000, parseInt(root.dataset.delay || '4500', 10));
    var speed = Math.max(150, parseInt(root.dataset.speed || '550', 10));

    root.style.setProperty('--mars-slider-speed', speed + 'ms');

    function slideOffset(index) {
      return slides[index] ? slides[index].offsetLeft : 0;
    }

    function scrollSlideIntoView(index, smooth) {
      if (!slides[index]) return;

      var viewportRect = viewport.getBoundingClientRect();
      var slideRect = slides[index].getBoundingClientRect();
      var delta = slideRect.right - viewportRect.right;

      if (Math.abs(delta) < 1) return;

      if (smooth === false) {
        cancelScrollAnimation();
        viewport.scrollLeft += delta;
      } else {
        animateTo(viewport.scrollLeft + delta, speed);
      }
    }

    function nearestIndex() {
      var rightEdge = viewport.getBoundingClientRect().right;
      var best = 0;
      var distance = Infinity;

      slides.forEach(function (slide, index) {
        var nextDistance = Math.abs(slide.getBoundingClientRect().right - rightEdge);
        if (nextDistance < distance) {
          distance = nextDistance;
          best = index;
        }
      });

      return best;
    }

    function syncNaturalHeight(index) {
      if (sizingMode !== 'natural') {
        viewport.style.height = '';
        return;
      }

      var slide = slides[clamp(index, 0, slides.length - 1)];
      if (!slide) return;

      window.requestAnimationFrame(function () {
        var height = Math.ceil(slide.getBoundingClientRect().height || slide.scrollHeight || 0);
        if (height > 0) viewport.style.height = height + 'px';
      });
    }

    function updateUi(index) {
      var nextCurrent = clamp(index, 0, slides.length - 1);
      var changed = nextCurrent !== current;
      current = nextCurrent;
      if (changed || !viewport.style.height) syncNaturalHeight(current);

      dots.forEach(function (dot, dotIndex) {
        var active = dotIndex === current;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      if (!loop) {
        // In RTL, the physical right arrow goes backward through the DOM index,
        // while the physical left arrow advances through it.
        if (next) next.disabled = current === 0;
        if (previous) previous.disabled = current === slides.length - 1;
      }
    }

    function cancelScrollAnimation() {
      if (animationFrame) {
        window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      }
    }

    function animateTo(target, milliseconds) {
      cancelScrollAnimation();

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || milliseconds <= 0) {
        viewport.scrollLeft = target;
        return;
      }

      var start = viewport.scrollLeft;
      var change = target - start;
      var started = window.performance.now();

      function step(now) {
        var progress = clamp((now - started) / milliseconds, 0, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        viewport.scrollLeft = start + (change * eased);

        if (progress < 1) {
          animationFrame = window.requestAnimationFrame(step);
        } else {
          animationFrame = 0;
          viewport.scrollLeft = target;
        }
      }

      animationFrame = window.requestAnimationFrame(step);
    }

    function goTo(index, smooth) {
      if (!slides.length) return;

      if (loop) {
        if (index < 0) index = slides.length - 1;
        if (index >= slides.length) index = 0;
      } else {
        index = clamp(index, 0, slides.length - 1);
      }

      updateUi(index);
      scrollSlideIntoView(index, smooth);
    }

    function stopAutoplay() {
      if (timer) {
        window.clearTimeout(timer);
        timer = 0;
      }
    }

    function scheduleAutoplay() {
      stopAutoplay();
      if (!autoplay || !visible || document.hidden || root.matches(':hover') && pauseHover) return;
      timer = window.setTimeout(function () {
        goTo(current + 1, true);
        scheduleAutoplay();
      }, delay);
    }

    function userNavigate(index) {
      goTo(index, true);
      scheduleAutoplay();
    }

    // RTL rule: the physical right arrow moves the slider right-to-left.
    if (next) {
      next.addEventListener('click', function () { userNavigate(current - 1); });
    }
    if (previous) {
      previous.addEventListener('click', function () { userNavigate(current + 1); });
    }

    dots.forEach(function (dot, index) {
      dot.addEventListener('click', function () { userNavigate(index); });
    });

    viewport.addEventListener('scroll', function () {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(function () {
        scrollFrame = 0;
        updateUi(nearestIndex());
      });
    }, { passive: true });

    viewport.addEventListener('keydown', function (event) {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        userNavigate(current - 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        userNavigate(current + 1);
      }
    });

    if (dragEnabled) {
      viewport.addEventListener('pointerdown', function (event) {
        if (event.pointerType === 'touch' || event.button !== 0) return;
        cancelScrollAnimation();
        pointerDown = true;
        dragged = false;
        pointerStartX = event.clientX;
        pointerStartScroll = viewport.scrollLeft;
        root.classList.add('is-dragging');
        viewport.setPointerCapture(event.pointerId);
        stopAutoplay();
      });

      viewport.addEventListener('pointermove', function (event) {
        if (!pointerDown) return;
        var delta = event.clientX - pointerStartX;
        if (Math.abs(delta) > 4) dragged = true;
        viewport.scrollLeft = pointerStartScroll - delta;
      });

      function finishDrag(event) {
        if (!pointerDown) return;
        pointerDown = false;
        root.classList.remove('is-dragging');
        try { viewport.releasePointerCapture(event.pointerId); } catch (error) {}
        goTo(nearestIndex(), true);
        scheduleAutoplay();
      }

      viewport.addEventListener('pointerup', finishDrag);
      viewport.addEventListener('pointercancel', finishDrag);
      viewport.addEventListener('dragstart', function (event) { event.preventDefault(); });
      viewport.addEventListener('click', function (event) {
        if (dragged) {
          event.preventDefault();
          event.stopPropagation();
          dragged = false;
        }
      }, true);
    }

    viewport.addEventListener('touchstart', stopAutoplay, { passive: true });
    viewport.addEventListener('touchend', function () {
      window.setTimeout(function () {
        updateUi(nearestIndex());
        scheduleAutoplay();
      }, 120);
    }, { passive: true });

    if (pauseHover) {
      root.addEventListener('mouseenter', stopAutoplay);
      root.addEventListener('mouseleave', scheduleAutoplay);
      root.addEventListener('focusin', stopAutoplay);
      root.addEventListener('focusout', scheduleAutoplay);
    }

    document.addEventListener('visibilitychange', scheduleAutoplay);

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.target !== root) return;
          visible = entry.isIntersecting && entry.intersectionRatio > 0.1;
          scheduleAutoplay();
        });
      }, { threshold: [0, 0.1, 0.5] });
      observer.observe(root);
    }

    slides.forEach(function (slide, index) {
      var image = slide.querySelector('img');
      if (!image) return;
      if (image.complete) syncNaturalHeight(current);
      image.addEventListener('load', function () {
        if (index === current) syncNaturalHeight(current);
      }, { passive: true });
    });

    if ('ResizeObserver' in window) {
      var resizeObserver = new ResizeObserver(function () {
        goTo(current, false);
        syncNaturalHeight(current);
      });
      resizeObserver.observe(viewport);
    } else {
      window.addEventListener('resize', function () {
        goTo(current, false);
        syncNaturalHeight(current);
      }, { passive: true });
    }

    updateUi(0);
    goTo(0, false);
    scheduleAutoplay();
  }

  function initWithin(scope) {
    var base = scope && scope.querySelectorAll ? scope : document;
    if (base.matches && base.matches('[data-mars-image-slider]')) initSlider(base);
    base.querySelectorAll('[data-mars-image-slider]').forEach(initSlider);
  }

  function boot() {
    initWithin(document);
  }

  window.marsInitImageSliders = initWithin;

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }

  document.addEventListener('mars:content-updated', function (event) {
    initWithin(event.detail && event.detail.scope ? event.detail.scope : document);
  });
  document.addEventListener('mars:ajax-loaded', function (event) {
    initWithin(event.detail && event.detail.scope ? event.detail.scope : document);
  });

  if (window.jQuery) {
    window.jQuery(window).on('elementor/frontend/init', function () {
      if (window.elementorFrontend && window.elementorFrontend.hooks) {
        window.elementorFrontend.hooks.addAction('frontend/element_ready/mars_image_slider.default', function ($scope) {
          initWithin($scope[0] || document);
        });
      }
    });
  }
})();
