\u062a\u0627\u0631\u06cc\u060c \u0648 \u0633\u06cc\u0633\u062a\u0645 \u0627\u0645\u062a\u06cc\u0627\u0632\u062f\u0647\u06cc \u062f\u0627\u0631\u062f. \u0627\u0645\u0627 \u0627\u06a9\u0627\u0646\u062a \u067e\u0631\u0645\u06cc\u0648\u0645 \u062f\u0648\u0644\u06cc\u0646\u06af\u0648 ( Max \u06cc\u0627 Super) \u0642\u0627\u0628\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc\u06cc \u0645\u0627\u0646\u0646\u062f \u062d\u0630\u0641 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a\u060c \u0627\u0645\u06a9\u0627\u0646 \u062a\u0645\u0631\u06cc\u0646 \u0622\u0641\u0644\u0627\u06cc\u0646\u060c \u0628\u0631\u0631\u0633\u06cc \u062f\u0642\u06cc\u0642\u200c\u062a\u0631 \u0627\u0634\u062a\u0628\u0627\u0647\u0627\u062a\u060c \u062a\u0645\u0631\u06cc\u0646\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc\u200c\u0633\u0627\u0632\u06cc\u200c\u0634\u062f\u0647 \u0648 \u062a\u062c\u0631\u0628\u0647 \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0633\u0631\u06cc\u0639\u200c\u062a\u0631 \u0648 \u0645\u062a\u0645\u0631\u06a9\u0632\u062a\u0631 \u0631\u0627 \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631\u062a\u0627\u0646 \u0642\u0631\u0627\u0631 \u0645\u06cc\u200c\u062f\u0647\u062f.<\/p>\n<h2 id=\"duolingo2\">\u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u0627\u06a9\u0627\u0646\u062a \u062f\u0648\u0644\u06cc\u0646\u06af\u0648<\/h2>\n<p>\u0627\u06a9\u0627\u0646\u062a \u062f\u0648\u0644\u06cc\u0646\u06af\u0648 \u0647\u0645\u0631\u0627\u0647 \u0648\u0641\u0627\u062f\u0627\u0631 \u0648 \u0647\u0645\u06cc\u0634\u06af\u06cc \u0634\u0645\u0627 \u0628\u0631\u0627\u06cc \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0632\u0628\u0627\u0646\u200c\u0647\u0627\u06cc \u06af\u0648\u0646\u0627\u06af\u0648\u0646 \u0627\u0633\u062a. \u0647\u0631 \u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u0628\u062e\u0648\u0627\u0647\u06cc\u062f \u0628\u0647 \u0634\u0645\u0627 \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f \u06a9\u0647 \u0622\u0645\u0648\u0632\u0634 \u062e\u0648\u062f \u0631\u0627 \u0641\u0631\u0627\u0645\u0648\u0634 \u0646\u06a9\u0646\u06cc\u062f\u061b \u0639\u0644\u0627\u0648\u0647\u200c\u200c\u0628\u0631 \u0622\u0646 \u062f\u0627\u0631\u0627\u06cc \u0642\u0627\u0628\u0644\u06cc\u062a\u200c\u200c\u0647\u0627\u06cc \u0632\u06cc\u0631 \u0627\u0633\u062a:<\/p>\n<h3>\u062d\u0630\u0641 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a<\/h3>\n<p>\u0628\u0627 \u062e\u0631\u06cc\u062f \u0627\u06a9\u0627\u0646\u062a \u062f\u0648\u0644\u06cc\u0646\u06af\u0648\u060c \u062a\u062c\u0631\u0628\u0647 \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0634\u0645\u0627 \u06a9\u0627\u0645\u0644\u0627\u064b \u0628\u062f\u0648\u0646 \u0645\u0632\u0627\u062d\u0645\u062a \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f\u061b \u0686\u0631\u0627\u06a9\u0647 \u062a\u0645\u0627\u0645 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u0628\u0646\u0631\u06cc\u060c \u0648\u06cc\u062f\u06cc\u0648\u06cc\u06cc \u0648 \u062f\u0631\u0648\u0646\u200c\u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0627\u06cc \u062d\u0630\u0641 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0627\u06cc\u0646 \u0648\u06cc\u0698\u06af\u06cc \u0628\u0647 \u0634\u0645\u0627 \u06a9\u0645\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u062f \u062a\u0627 \u0628\u0627 \u062a\u0645\u0631\u06a9\u0632 \u0628\u06cc\u0634\u062a\u0631 \u0648 \u0628\u062f\u0648\u0646 \u0648\u0642\u0641\u0647\u200c\u0647\u0627\u06cc \u0622\u0632\u0627\u0631\u062f\u0647\u0646\u062f\u0647\u060c \u0641\u0631\u0627\u06cc\u0646\u062f \u06cc\u0627\u062f\u06af\u06cc\u0631\u06cc \u0631\u0627 \u062f\u0646\u0628\u0627\u0644 \u06a9\u0646\u06cc\u062f.<\/p>\n<h3>\u0642\u0644\u0628\u200c\u0647\u0627\u06cc \u0646\u0627\u0645\u062d\u062f\u0648\u062f<\/h3>\n<p>\u062f\u0631 \u0646\u0633\u062e\u0647 \u0631\u0627\u06cc\u06af\u0627\u0646\u060c \u0628\u0627 \u0647\u0631 \u0627\u0634\u062a\u0628\u0627\u0647\u060c \u06cc\u06a9\u06cc \u0627\u0632 \u0642\u0644\u0628\u200c\u0647\u0627\u06cc \u0634\u0645\u0627 \u06a9\u0645 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u062f\u0631 \u06