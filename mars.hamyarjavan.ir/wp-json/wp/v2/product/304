c \u0628\u0633\u06cc\u0627\u0631 \u0633\u0627\u062f\u0647\u200c\u0627\u06cc \u062f\u0627\u0631\u062f \u0648 \u0647\u0645\u0647 \u0686\u06cc\u0632 \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u0628\u0644\u0648\u06a9\u200c\u0628\u0647\u200c\u0628\u0644\u0648\u06a9 (Block-based) \u0633\u0627\u062e\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f\u060c \u06cc\u06a9 \u0635\u0641\u062d\u0647 \u0633\u0627\u062f\u0647 \u06cc\u0627 \u06cc\u06a9 \u0633\u06cc\u0633\u062a\u0645 \u067e\u06cc\u0686\u06cc\u062f\u0647 \u0631\u0627 \u0628\u0647\u200c\u0631\u0627\u062d\u062a\u06cc \u062e\u0644\u0642 \u06a9\u0646\u06cc\u062f.<\/p>\n<h2 id=\"Notion2\">\u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u0627\u06a9\u0627\u0646\u062a NOTION<\/h2>\n<p>\u0646\u0648\u0634\u0646 &#8211; \u0627\u0628\u0632\u0627\u0631 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0648 \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0631\u06cc\u0632\u06cc \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644 &#8211; \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u06af\u0633\u062a\u0631\u062f\u0647\u200c\u0627\u06cc \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631\u062a\u0627\u0646 \u0642\u0631\u0627\u0631 \u0645\u06cc\u200c\u062f\u0647\u062f\u061b \u0645\u0648\u0627\u0631\u062f \u0632\u06cc\u0631 \u0627\u0632 \u0648\u06cc\u0698\u06af\u06cc\u200c\u200c\u0647\u0627\u06cc \u062d\u0627\u0626\u0632 \u0627\u0647\u0645\u06cc\u062a \u0627\u06cc\u0646 \u067e\u0644\u062a\u0641\u0631\u0645 \u0627\u0633\u062a.<\/p>\n<h3>\u0633\u0641\u0627\u0631\u0634\u06cc\u200c\u0633\u0627\u0632\u06cc\u06cc \u0635\u0641\u062d\u0627\u062a<\/h3>\n<p>\u0628\u0627 Notion \u0647\u0631 \u0635\u0641\u062d\u0647\u200c\u0627\u06cc \u0631\u0627 \u0645\u0637\u0627\u0628\u0642 \u0628\u0627 \u0633\u0644\u06cc\u0642\u0647\u200c\u06cc \u062e\u0648\u062f \u0637\u0631\u0627\u062d\u06cc \u0648 \u0634\u062e\u0635\u06cc\u200c\u0633\u0627\u0632\u06cc \u06a9\u0646\u06cc\u062f. \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0631\u0627\u06cc \u0635\u0641\u062d\u0627\u062a\u060c \u0646\u0627\u0645 \u062f\u0644\u062e\u0648\u0627\u0647\u060c \u06a9\u0627\u0648\u0631 (\u062a\u0635\u0648\u06cc\u0631 \u0633\u0631\u0628\u0631\u06af) \u0648 \u0627\u06cc\u0645\u0648\u062c\u06cc \u062f\u0644\u062e\u0648\u0627\u0647 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f \u0648 \u0631\u0646\u06af\u200c\u0628\u0646\u062f\u06cc \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0647\u06cc\u062f. \u0627\u06cc\u0646 \u0642\u0627\u0628\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u0633\u0641\u0627\u0631\u0634\u06cc \u0646\u0638\u0645 \u0648 \u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u0633\u0631\u06cc\u0639\u200c\u062a\u0631 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0631\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f.<\/p>\n<h3>\u062f\u0633\u062a\u0631\u0633\u06cc \u0628\u0647 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc<\/h3>\n<p>\u0646\u0633\u062e\u0647 \u0645\u062c\u0647\u0632 \u0628\u0647 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc Notion \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u062f\u0631 \u0641\u0631\u0627\u06cc\u0646\u062f \u062a\u0648\u0644\u06cc\u062f \u0645\u062d\u062a\u0648\u0627\u060c \u062a\u062d\u0644\u06cc\u0644 \u062f\u0627\u062f\u0647\u060c \u0637\u0631\u0627\u062d\u06cc \u0635\u0641\u062d\u0627\u062a \u0648 \u062d\u062a\u06cc \u0646\u0648\u0634\u062a\u0646 \u0645\u062a\u0646\u200c\u0647\u0627\u06cc \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u06cc \u0628\u0647 \u0634\u0645\u0627 \u06a9\u0645\u06a9 \u06a9\u0646\u062f. \u0627\u06cc\u0646 \u0627\u0628\u0632\u0627\u0631 \u0647\u0648\u0634\u0645\u0646\u062f \u0647\u0645\u0648\u0627\u0631\u0647 \u062f\u0631 \u067e\u0627\u06cc\u06cc\u0646 \u0633\u0645\u062a \u0686\u067e \u0635\u0641\u062d\u0647 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0627\u0633\u062a \u0648 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u062f\u0631 \u0632\u0645\u06cc\u0646\u0647\u200c\u0647\u0627\u06cc\u06cc \